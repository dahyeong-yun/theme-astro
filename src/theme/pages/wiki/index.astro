---
/**
 * 위키 대문.
 *
 * 그냥 목록만 두면 눌러 들어왔을 때 여기가 어떤 곳인지 알 수 없다.
 * 무엇을 모아둔 곳인지 먼저 말하고, 갈래로 들어가는 입구를 보여준 다음,
 * 전체 목록을 잇는다.
 *
 * 문서를 묶는 축은 둘로 줄였다. 개념의 소속은 갈래가, 가로지르는 꼬리표는 태그가 맡는다.
 * 폴더는 파일을 어디 뒀는지일 뿐이라 화면에 드러내지 않는다.
 * 최근 갱신 목록은 대문(/)이 이미 같은 것을 보여주고 있어 여기서 뺐다.
 */
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PageHeader from '../../components/PageHeader.astro'
import DocList, { type DocListItem } from '../../components/DocList.astro'
import { getGitCreated } from '../../lib/git-dates.js'
import { pageHeading } from '../../lib/nav.js'
import { getBranchIndex, countDocs } from '../../lib/branches.js'
import { isVisible } from '../../lib/drafts.js'
import { postsPerPage } from '../../lib/posts.js'

const wikiBase = (config.wiki?.basePath ?? '/wiki').replace(/\/+$/, '')
// 내비에 적어 둔 문구가 있으면 그것을 쓰고, 없으면 wiki 설정을 쓴다.
const heading = pageHeading(wikiBase, {
  title: config.wiki?.title ?? 'Wiki',
  description: config.wiki?.description,
})
const wikiTitle = heading.title
const wikiDescription = heading.description

let entries: any[] = []
try {
  entries = (await getCollection('wiki' as any)) ?? []
} catch {
  entries = []
}

const locale = config.site.language || 'ko'

// 폴더는 파일을 어디 뒀는지일 뿐 개념의 묶음이 아니라, 목록을 폴더로 나누지 않는다.
// 개념의 소속은 갈래가, 가로지르는 꼬리표는 태그가 맡는다.
const pages: DocListItem[] = entries
  .filter((entry) => isVisible(entry.data))
  .map((entry) => {
    const docPath = entry.id.replace(/^\/+|\/+$/g, '').replace(/\/index$/, '')
    const slug = (entry.data.slug ?? docPath).replace(/^\/|\/$/g, '')
    return {
      title: entry.data.title,
      url: `${wikiBase}/${slug}/`,
      description: entry.data.description,
      date: entry.data.updated ?? entry.data.created,
      timeFrom: getGitCreated(entry.filePath),
      tags: entry.data.tags ?? [],
    }
  })
  // 최근 갱신순이 아니라 제목순이다. 이 목록은 이제 전체 색인이고,
  // 색인은 아는 것을 찾는 자리다. 최근 갱신은 대문(/)이 맡는다.
  .sort((a, b) => a.title.localeCompare(b.title, locale))

const allTags = [...new Set(pages.flatMap((p) => p.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, locale),
)

// 한 쪽에 몇 개를 둘지는 블로그와 같은 손잡이를 쓴다. 목록이 길어지는 이유가
// 같으니 끊는 길이도 따로 둘 이유가 없다.
const perPage = postsPerPage()

// 갈래는 최상위만 카드로 세운다. 대문은 입구지 목차가 아니다.
// 다만 바로 아래 자식 이름은 카드 안에 깔아 준다. 최상위만 보이면
// 갈래가 몇 겹인지 알 수 없어 폴더 분류와 구분이 안 된다.
const branchIndex = await getBranchIndex()
const rootBranches = branchIndex.roots.map((root) => ({
  ...root,
  total: countDocs(root),
}))
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${wikiTitle} | ${config.site.title}`}
      description={wikiDescription ?? config.site.description}
    />
    <style>
      .stats {
        margin: 0.75rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
      .branch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.75rem;
      }
      .branch-card {
        display: block;
        padding: 0.9rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        text-decoration: none;
        transition: border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .branch-card:hover {
        border-color: var(--color-accent);
        background: var(--color-surface-secondary);
      }
      .branch-name {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text-primary);
      }
      .branch-count {
        font-size: 0.8rem;
        font-weight: 400;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }
      .branch-desc {
        margin: 0.3rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
      }
      /* 바로 아래 갈래 이름만 깔아 둔다. 링크로 만들면 카드 안에 링크가
         겹쳐 눌리는 곳이 헷갈린다. 여기서는 지도의 모양만 보여준다. */
      .branch-children {
        margin: 0.5rem 0 0;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        opacity: 0.75;
        line-height: 1.5;
      }
      .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.5rem;
      }
      .tag-filter button {
        font: inherit;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        background: none;
        padding: 0.16rem 0.55rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        cursor: pointer;
        transition: color var(--transition-speed) var(--transition-timing),
                    border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .tag-filter button:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }
      .tag-filter button[aria-pressed='true'] {
        color: var(--color-accent);
        border-color: transparent;
        background: var(--color-badge-bg);
      }
         리셋 버튼이 있을 이유가 없어 그때는 숨는다. */
      .filter-status {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0 0 1rem;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
      .filter-tag {
        color: var(--color-accent);
        font-weight: 600;
      }
      .filter-reset {
        font: inherit;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        background: none;
        border: 0;
        padding: 0;
        margin-left: auto;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        cursor: pointer;
        transition: color var(--transition-speed) var(--transition-timing);
      }
      .filter-reset:hover {
        color: var(--color-accent);
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader title={wikiTitle} description={wikiDescription}>
        {pages.length > 0 && (
          <p class="stats">
            문서 {pages.length}개
            {rootBranches.length > 0 && ` · 갈래 ${rootBranches.length}개`}
            {allTags.length > 0 && ` · 태그 ${allTags.length}개`}
          </p>
        )}
      </PageHeader>

      {pages.length === 0 ? (
        <p class="empty-state">아직 정리해 둔 문서가 없습니다.</p>
      ) : (
        <>
          {rootBranches.length > 0 && (
            <section class="page-section">
              <h2 class="section-title">갈래</h2>
              <div class="branch-grid">
                {rootBranches.map((root) => (
                  <a class="branch-card" href={root.url}>
                    <span class="branch-name">
                      {root.title}
                      <span class="branch-count">{root.total}</span>
                    </span>
                    {root.description && <p class="branch-desc">{root.description}</p>}
                    {root.children.length > 0 && (
                      <p class="branch-children">
                        {root.children.map((child) => child.title).join(' · ')}
                      </p>
                    )}
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="page-section" id="all-docs">
            <h2 class="section-title">전체 문서</h2>
            {allTags.length > 0 && (
              <div class="tag-filter" id="tag-filter">
                <button type="button" data-tag="" aria-pressed="true">전체</button>
                {allTags.map((tag) => (
                  <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>
                ))}
              </div>
            )}
            <p class="filter-status" id="filter-status" hidden>
              <span class="filter-tag"></span>
              <span class="filter-count"></span>
              <button type="button" class="filter-reset">전체 보기</button>
            </p>
            <DocList items={pages} showDescription />
            <p class="no-match" hidden>고른 태그에 해당하는 문서가 없습니다.</p>
            <nav
              class="pagination"
              id="doc-pagination"
              data-per-page={perPage}
              aria-label="문서 목록 쪽 이동"
              hidden
            ></nav>
          </section>
        </>
      )}
    </main>
    <Footer />

    <script>
      // 태그 필터와 쪽 나눔. ?tag=&page= 로 들어와도 같은 상태가 되도록 URL 과 맞춘다.
      function setupWikiFilter() {
        const filter = document.getElementById('tag-filter')
        const list = document.querySelector<HTMLElement>('.doc-list')
        const noMatch = document.querySelector<HTMLElement>('.no-match')
        const status = document.getElementById('filter-status')
        const nav = document.getElementById('doc-pagination')
        const section = document.getElementById('all-docs')
        if (!list) return

        const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'))
        const perPage = Math.max(1, Number(nav?.dataset.perPage) || 10)

        let tag = ''
        let page = 1

        /** 현재 쪽 주변만 보여주고 나머지는 줄임표로 접는다.
            Pagination.astro 의 pageNumbers 를 그대로 옮겨 적었다. 그쪽은 서버
            컴포넌트라 여기서 import 할 수 없고, 이것 하나 때문에 공유 모듈을
            새로 만들 만큼은 아니다. 한쪽을 고치면 다른 쪽도 같이 고쳐야 한다. */
        function pageNumbers(current: number, total: number): (number | '…')[] {
          if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)

          const pages = new Set<number>([1, total, current])
          if (current - 1 > 1) pages.add(current - 1)
          if (current + 1 < total) pages.add(current + 1)

          const sorted = [...pages].sort((a, b) => a - b)
          const out: (number | '…')[] = []
          let previous = 0
          for (const value of sorted) {
            if (previous && value - previous > 1) out.push('…')
            out.push(value)
            previous = value
          }
          return out
        }

        function renderPagination(current: number, total: number) {
          if (!nav) return
          nav.hidden = total <= 1
          if (total <= 1) {
            nav.replaceChildren()
            return
          }

          const step = (label: string, target: number, rel: string) => {
            const button = document.createElement('button')
            button.type = 'button'
            button.className = 'step'
            button.textContent = label
            const usable = target >= 1 && target <= total
            if (usable) {
              button.dataset.page = String(target)
              button.setAttribute('rel', rel)
            } else {
              button.classList.add('disabled')
              button.disabled = true
              button.setAttribute('aria-hidden', 'true')
            }
            return button
          }

          const pages = document.createElement('ol')
          pages.className = 'pages'
          for (const value of pageNumbers(current, total)) {
            const li = document.createElement('li')
            if (value === '…') {
              li.className = 'gap'
              li.setAttribute('aria-hidden', 'true')
              li.textContent = '…'
            } else if (value === current) {
              const span = document.createElement('span')
              span.className = 'page current'
              span.setAttribute('aria-current', 'page')
              span.textContent = String(value)
              li.append(span)
            } else {
              const button = document.createElement('button')
              button.type = 'button'
              button.className = 'page'
              button.dataset.page = String(value)
              button.textContent = String(value)
              li.append(button)
            }
            pages.append(li)
          }

          nav.replaceChildren(
            step('← 이전', current - 1, 'prev'),
            pages,
            step('다음 →', current + 1, 'next'),
          )
        }

        function apply() {
          const matched = items.filter((item) => {
            const tags = (item.dataset.tags || '').split('|').filter(Boolean)
            return !tag || tags.includes(tag)
          })

          const total = Math.max(1, Math.ceil(matched.length / perPage))
          page = Math.min(Math.max(1, page), total)
          const shown = matched.slice((page - 1) * perPage, page * perPage)

          for (const item of items) {
            item.hidden = true
            item.classList.remove('is-last-visible')
          }
          for (const item of shown) item.hidden = false
          // 구분선은 줄 사이에만 둔다. 뒤쪽이 숨겨지면 마지막으로 보이는 줄에서 선을 뗀다.
          shown[shown.length - 1]?.classList.add('is-last-visible')

          list.hidden = matched.length === 0
          if (noMatch) noMatch.hidden = matched.length > 0

          if (filter) {
            // 하나를 고르면 나머지는 물러선다. 흐리게 하는 일은 CSS 가 맡는다.
            for (const button of Array.from(filter.querySelectorAll('button'))) {
              button.setAttribute(
                'aria-pressed',
                String((button.getAttribute('data-tag') || '') === tag),
              )
            }
          }

          if (status) {
            status.hidden = !tag
            const name = status.querySelector<HTMLElement>('.filter-tag')
            const count = status.querySelector<HTMLElement>('.filter-count')
            if (name) name.textContent = tag ? `#${tag}` : ''
            if (count) count.textContent = tag ? `문서 ${matched.length}개` : ''
          }

          renderPagination(page, total)

          const url = new URL(window.location.href)
          if (tag) url.searchParams.set('tag', tag)
          else url.searchParams.delete('tag')
          if (page > 1) url.searchParams.set('page', String(page))
          else url.searchParams.delete('page')
          window.history.replaceState({}, '', url)
        }

        filter?.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest('button')
          if (!button) return
          const next = button.getAttribute('data-tag') || ''
          tag = button.getAttribute('data-tag') || ''
          page = 1
          apply()
        })

        status?.querySelector('.filter-reset')?.addEventListener('click', () => {
          tag = ''
          page = 1
          apply()
        })

        nav?.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest<HTMLElement>('[data-page]')
          if (!button) return
          page = Number(button.dataset.page)
          apply()
          // 아래쪽 번호를 눌렀는데 화면이 그대로면 무엇이 바뀌었는지 알 수 없다.
          section?.scrollIntoView({ block: 'start' })
        })

        const params = new URL(window.location.href).searchParams
        tag = params.get('tag') || ''
        page = Number(params.get('page')) || 1
        apply()
      }

      document.addEventListener('astro:page-load', setupWikiFilter)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupWikiFilter)
      } else {
        setupWikiFilter()
      }
    </script>
  </body>
</html>
