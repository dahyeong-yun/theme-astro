---
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import FormattedDate from '../../components/FormattedDate.astro'

const wikiBase = (config.wiki?.basePath ?? '/wiki').replace(/\/+$/, '')
const wikiTitle = config.wiki?.title ?? 'Wiki'
const wikiDescription =
  config.wiki?.description ?? '정리해 둔 정보성 문서 모음. 계속 고쳐 씁니다.'

let entries: any[] = []
try {
  entries = (await getCollection('wiki' as any)) ?? []
} catch {
  entries = []
}

interface WikiItem {
  title: string
  url: string
  description?: string
  updated?: Date
  tags: string[]
  group: string
}

const pages: WikiItem[] = entries
  .filter((entry) => !entry.data.draft)
  .map((entry) => {
    const docPath = entry.id.replace(/^\/+|\/+$/g, '').replace(/\/index$/, '')
    const slug = entry.data.slug ? entry.data.slug.replace(/^\/|\/$/g, '') : docPath
    const segments = docPath.split('/')
    return {
      title: entry.data.title,
      url: `${wikiBase}/${slug}/`,
      description: entry.data.description,
      updated: entry.data.updated ?? entry.data.created,
      tags: entry.data.tags ?? [],
      // 최상위 폴더를 분류로 쓴다. 루트에 바로 놓인 문서는 '기타'.
      group: segments.length > 1 ? segments[0] : '기타',
    }
  })

const groups = [...new Set(pages.map((p) => p.group))].sort((a, b) => {
  if (a === '기타') return 1
  if (b === '기타') return -1
  return a.localeCompare(b, config.site.language || 'ko')
})

const allTags = [...new Set(pages.flatMap((p) => p.tags))].sort((a, b) =>
  a.localeCompare(b, config.site.language || 'ko'),
)

const byGroup = groups.map((group) => ({
  group,
  items: pages
    .filter((p) => p.group === group)
    .sort((a, b) => a.title.localeCompare(b.title, config.site.language || 'ko')),
}))
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`${wikiTitle} | ${config.site.title}`} description={wikiDescription} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        font-family: var(--font-sans);
      }
      @media (max-width: 640px) {
        main {
          padding: 1.5rem 1rem;
        }
      }
      h1.page-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.01em;
      }
      .page-desc {
        margin: 0 0 2rem 0;
        color: var(--color-text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
      }
      .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 2.5rem;
      }
      .tag-filter button {
        font: inherit;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        background: none;
        padding: 0.16rem 0.55rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
      }
      .tag-filter button:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }
      .tag-filter button[aria-pressed='true'] {
        color: var(--color-accent);
        border-color: transparent;
        background: var(--color-badge-bg);
      }
      section.group {
        margin-bottom: 2.5rem;
      }
      section.group[hidden] {
        display: none;
      }
      h2.group-title {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin: 0 0 0.75rem 0;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 0;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      li[hidden] {
        display: none;
      }
      li a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 0.15s;
        min-width: 0;
      }
      li a:hover {
        color: var(--color-accent);
      }
      .item-title {
        font-size: 1rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
      }
      .item-date {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
        flex-shrink: 0;
      }
      .item-desc {
        margin: 0.15rem 0 0 0;
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
      }
      .empty {
        color: var(--color-text-secondary);
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">{wikiTitle}</h1>
      <p class="page-desc">{wikiDescription}</p>

      {allTags.length > 0 && (
        <div class="tag-filter" id="tag-filter">
          <button type="button" data-tag="" aria-pressed="true">전체</button>
          {allTags.map((tag) => (
            <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>
          ))}
        </div>
      )}

      {pages.length === 0 && (
        <p class="empty">아직 위키 문서가 없습니다. <code>content/wiki/</code> 에 문서를 추가해 보세요.</p>
      )}

      {byGroup.map(({ group, items }) => (
        <section class="group" data-group={group}>
          <h2 class="group-title">{group}</h2>
          <ul>
            {items.map((item) => (
              <li data-tags={item.tags.join('|')}>
                <a href={item.url}>
                  <span class="item-title">{item.title}</span>
                  {item.updated && (
                    <span class="item-date"><FormattedDate date={item.updated} /></span>
                  )}
                </a>
                {item.description && <p class="item-desc">{item.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>
    <Footer />

    <script>
      // 태그 필터. ?tag=... 로 들어와도 같은 상태가 되도록 URL 과 맞춘다.
      function setupWikiFilter() {
        const filter = document.getElementById('tag-filter')
        const sections = Array.from(document.querySelectorAll<HTMLElement>('section.group'))
        if (sections.length === 0) return

        function apply(tag: string) {
          for (const section of sections) {
            let visible = 0
            const items = Array.from(section.querySelectorAll<HTMLElement>('li'))
            for (const item of items) {
              const tags = (item.dataset.tags || '').split('|').filter(Boolean)
              const show = !tag || tags.includes(tag)
              item.hidden = !show
              if (show) visible++
            }
            section.hidden = visible === 0
          }
          if (filter) {
            for (const button of Array.from(filter.querySelectorAll('button'))) {
              button.setAttribute(
                'aria-pressed',
                String((button.getAttribute('data-tag') || '') === tag),
              )
            }
          }
        }

        filter?.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest('button')
          if (!button) return
          const tag = button.getAttribute('data-tag') || ''
          const url = new URL(window.location.href)
          if (tag) url.searchParams.set('tag', tag)
          else url.searchParams.delete('tag')
          window.history.replaceState({}, '', url)
          apply(tag)
        })

        apply(new URL(window.location.href).searchParams.get('tag') || '')
      }

      document.addEventListener('astro:page-load', setupWikiFilter)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupWikiFilter)
      } else {
        setupWikiFilter()
      }
    </script>
  </body>
</html>
