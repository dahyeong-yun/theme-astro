---
/**
 * 위키 대문.
 *
 * 그냥 목록만 두면 눌러 들어왔을 때 여기가 어떤 곳인지 알 수 없다.
 * 무엇을 모아둔 곳인지 먼저 말하고, 분류로 들어가는 입구를 보여준 다음,
 * 최근에 손댄 문서와 전체 목록을 잇는다.
 */
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PageHeader from '../../components/PageHeader.astro'
import DocList, { type DocListItem } from '../../components/DocList.astro'
import { getGitCreated } from '../../lib/git-dates.js'
import { pageHeading } from '../../lib/nav.js'

const wikiBase = (config.wiki?.basePath ?? '/wiki').replace(/\/+$/, '')
// 내비에 적어 둔 문구가 있으면 그것을 쓰고, 없으면 wiki 설정을 쓴다.
const heading = pageHeading(wikiBase, {
  title: config.wiki?.title ?? 'Wiki',
  description: config.wiki?.description,
})
const wikiTitle = heading.title
const wikiDescription = heading.description

let entries: any[] = []
try {
  entries = (await getCollection('wiki' as any)) ?? []
} catch {
  entries = []
}

interface WikiItem extends DocListItem {
  group: string
  sortKey: number
}

const pages: WikiItem[] = entries
  .filter((entry) => !entry.data.draft)
  .map((entry) => {
    const docPath = entry.id.replace(/^\/+|\/+$/g, '').replace(/\/index$/, '')
    const slug = (entry.data.slug ?? docPath).replace(/^\/|\/$/g, '')
    const segments = docPath.split('/')
    const updated = entry.data.updated ?? entry.data.created
    return {
      title: entry.data.title,
      url: `${wikiBase}/${slug}/`,
      description: entry.data.description,
      date: updated,
      timeFrom: getGitCreated(entry.filePath),
      tags: entry.data.tags ?? [],
      // 최상위 폴더를 분류로 쓴다. 루트에 바로 놓인 문서는 '기타'.
      group: segments.length > 1 ? segments[0] : '기타',
      sortKey: updated?.valueOf() ?? 0,
    }
  })

const locale = config.site.language || 'ko'

const groups = [...new Set(pages.map((p) => p.group))].sort((a, b) => {
  if (a === '기타') return 1
  if (b === '기타') return -1
  return a.localeCompare(b, locale)
})

const byGroup = groups.map((group) => ({
  group,
  anchor: `category-${encodeURIComponent(group)}`,
  items: pages
    .filter((p) => p.group === group)
    .sort((a, b) => a.title.localeCompare(b.title, locale)),
}))

const recent = [...pages].sort((a, b) => b.sortKey - a.sortKey).slice(0, 5)

const allTags = [...new Set(pages.flatMap((p) => p.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, locale),
)
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${wikiTitle} | ${config.site.title}`}
      description={wikiDescription ?? config.site.description}
    />
    <style>
      .stats {
        margin: 0.75rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
      .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.75rem;
      }
      .category-card {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        text-decoration: none;
        background: var(--color-surface);
        transition: border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .category-card:hover {
        border-color: var(--color-accent);
        background: var(--color-surface-secondary);
      }
      .category-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .category-count {
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }
      .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.5rem;
      }
      .tag-filter button {
        font: inherit;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        background: none;
        padding: 0.16rem 0.55rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        cursor: pointer;
        transition: color var(--transition-speed) var(--transition-timing),
                    border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .tag-filter button:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }
      .tag-filter button[aria-pressed='true'] {
        color: var(--color-accent);
        border-color: transparent;
        background: var(--color-badge-bg);
      }
      .category-block + .category-block {
        margin-top: 2rem;
      }
      .category-block[hidden] {
        display: none;
      }
      .category-block h3 {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin: 0 0 0.75rem;
        scroll-margin-top: 5rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader title={wikiTitle} description={wikiDescription}>
        {pages.length > 0 && (
          <p class="stats">문서 {pages.length}개 · 분류 {groups.length}개</p>
        )}
      </PageHeader>

      {pages.length === 0 ? (
        <p class="empty-state">아직 정리해 둔 문서가 없습니다.</p>
      ) : (
        <>
          <section class="page-section">
            <h2 class="section-title">분류</h2>
            <div class="category-grid">
              {byGroup.map(({ group, anchor, items }) => (
                <a class="category-card" href={`#${anchor}`}>
                  <span class="category-name">{group}</span>
                  <span class="category-count">{items.length}</span>
                </a>
              ))}
            </div>
          </section>

          <section class="page-section">
            <h2 class="section-title">최근 갱신</h2>
            <DocList items={recent} showDescription />
          </section>

          <section class="page-section">
            <h2 class="section-title">전체 문서</h2>
            {allTags.length > 0 && (
              <div class="tag-filter" id="tag-filter">
                <button type="button" data-tag="" aria-pressed="true">전체</button>
                {allTags.map((tag) => (
                  <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>
                ))}
              </div>
            )}
            {byGroup.map(({ group, anchor, items }) => (
              <div class="category-block" data-group={group}>
                <h3 id={anchor}>{group}</h3>
                <DocList items={items} />
              </div>
            ))}
          </section>
        </>
      )}
    </main>
    <Footer />

    <script>
      // 태그 필터. ?tag=... 로 들어와도 같은 상태가 되도록 URL 과 맞춘다.
      function setupWikiFilter() {
        const filter = document.getElementById('tag-filter')
        const blocks = Array.from(document.querySelectorAll<HTMLElement>('.category-block'))
        if (blocks.length === 0) return

        function apply(tag: string) {
          for (const block of blocks) {
            const shown: HTMLElement[] = []
            for (const item of Array.from(block.querySelectorAll<HTMLElement>('.doc-list > li'))) {
              const tags = (item.dataset.tags || '').split('|').filter(Boolean)
              const show = !tag || tags.includes(tag)
              item.hidden = !show
              item.classList.remove('is-last-visible')
              if (show) shown.push(item)
            }
            // 구분선은 줄 사이에만 둔다. 뒤쪽이 숨겨지면 마지막으로 보이는 줄에서 선을 뗀다.
            shown[shown.length - 1]?.classList.add('is-last-visible')
            block.hidden = shown.length === 0
          }
          if (filter) {
            for (const button of Array.from(filter.querySelectorAll('button'))) {
              button.setAttribute(
                'aria-pressed',
                String((button.getAttribute('data-tag') || '') === tag),
              )
            }
          }
        }

        filter?.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest('button')
          if (!button) return
          const tag = button.getAttribute('data-tag') || ''
          const url = new URL(window.location.href)
          if (tag) url.searchParams.set('tag', tag)
          else url.searchParams.delete('tag')
          window.history.replaceState({}, '', url)
          apply(tag)
        })

        apply(new URL(window.location.href).searchParams.get('tag') || '')
      }

      document.addEventListener('astro:page-load', setupWikiFilter)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupWikiFilter)
      } else {
        setupWikiFilter()
      }
    </script>
  </body>
</html>
