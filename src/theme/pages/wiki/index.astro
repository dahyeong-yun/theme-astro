---
/**
 * 위키 대문.
 *
 * 그냥 목록만 두면 눌러 들어왔을 때 여기가 어떤 곳인지 알 수 없다.
 * 무엇을 모아둔 곳인지 먼저 말하고, 갈래로 들어가는 입구를 보여준 다음,
 * 전체 목록을 잇는다.
 *
 * 문서를 묶는 축은 둘로 줄였다. 개념의 소속은 갈래가, 가로지르는 꼬리표는 태그가 맡는다.
 * 폴더는 파일을 어디 뒀는지일 뿐이라 화면에 드러내지 않는다.
 * 최근 갱신 목록은 대문(/)이 이미 같은 것을 보여주고 있어 여기서 뺐다.
 */
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PageHeader from '../../components/PageHeader.astro'
import DocList, { type DocListItem } from '../../components/DocList.astro'
import { getGitCreated } from '../../lib/git-dates.js'
import { pageHeading } from '../../lib/nav.js'
import { getBranchIndex, countDocs } from '../../lib/branches.js'

const wikiBase = (config.wiki?.basePath ?? '/wiki').replace(/\/+$/, '')
// 내비에 적어 둔 문구가 있으면 그것을 쓰고, 없으면 wiki 설정을 쓴다.
const heading = pageHeading(wikiBase, {
  title: config.wiki?.title ?? 'Wiki',
  description: config.wiki?.description,
})
const wikiTitle = heading.title
const wikiDescription = heading.description

let entries: any[] = []
try {
  entries = (await getCollection('wiki' as any)) ?? []
} catch {
  entries = []
}

const locale = config.site.language || 'ko'

// 폴더는 파일을 어디 뒀는지일 뿐 개념의 묶음이 아니라, 목록을 폴더로 나누지 않는다.
// 개념의 소속은 갈래가, 가로지르는 꼬리표는 태그가 맡는다.
const pages: DocListItem[] = entries
  .filter((entry) => !entry.data.draft)
  .map((entry) => {
    const docPath = entry.id.replace(/^\/+|\/+$/g, '').replace(/\/index$/, '')
    const slug = (entry.data.slug ?? docPath).replace(/^\/|\/$/g, '')
    return {
      title: entry.data.title,
      url: `${wikiBase}/${slug}/`,
      description: entry.data.description,
      date: entry.data.updated ?? entry.data.created,
      timeFrom: getGitCreated(entry.filePath),
      tags: entry.data.tags ?? [],
    }
  })
  // 최근 갱신순이 아니라 제목순이다. 이 목록은 이제 전체 색인이고,
  // 색인은 아는 것을 찾는 자리다. 최근 갱신은 대문(/)이 맡는다.
  .sort((a, b) => a.title.localeCompare(b.title, locale))

const allTags = [...new Set(pages.flatMap((p) => p.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, locale),
)

// 갈래는 최상위만 카드로 세운다. 대문은 입구지 목차가 아니다.
// 다만 바로 아래 자식 이름은 카드 안에 깔아 준다. 최상위만 보이면
// 갈래가 몇 겹인지 알 수 없어 폴더 분류와 구분이 안 된다.
const branchIndex = await getBranchIndex()
const rootBranches = branchIndex.roots.map((root) => ({
  ...root,
  total: countDocs(root),
}))
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${wikiTitle} | ${config.site.title}`}
      description={wikiDescription ?? config.site.description}
    />
    <style>
      .stats {
        margin: 0.75rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
      .branch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.75rem;
      }
      .branch-card {
        display: block;
        padding: 0.9rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        text-decoration: none;
        transition: border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .branch-card:hover {
        border-color: var(--color-accent);
        background: var(--color-surface-secondary);
      }
      .branch-name {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text-primary);
      }
      .branch-count {
        font-size: 0.8rem;
        font-weight: 400;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }
      .branch-desc {
        margin: 0.3rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
      }
      /* 바로 아래 갈래 이름만 깔아 둔다. 링크로 만들면 카드 안에 링크가
         겹쳐 눌리는 곳이 헷갈린다. 여기서는 지도의 모양만 보여준다. */
      .branch-children {
        margin: 0.5rem 0 0;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        opacity: 0.75;
        line-height: 1.5;
      }
      .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.5rem;
      }
      .tag-filter button {
        font: inherit;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        background: none;
        padding: 0.16rem 0.55rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        cursor: pointer;
        transition: color var(--transition-speed) var(--transition-timing),
                    border-color var(--transition-speed) var(--transition-timing),
                    background-color var(--transition-speed) var(--transition-timing);
      }
      .tag-filter button:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }
      .tag-filter button[aria-pressed='true'] {
        color: var(--color-accent);
        border-color: transparent;
        background: var(--color-badge-bg);
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader title={wikiTitle} description={wikiDescription}>
        {pages.length > 0 && (
          <p class="stats">
            문서 {pages.length}개
            {rootBranches.length > 0 && ` · 갈래 ${rootBranches.length}개`}
          </p>
        )}
      </PageHeader>

      {pages.length === 0 ? (
        <p class="empty-state">아직 정리해 둔 문서가 없습니다.</p>
      ) : (
        <>
          {rootBranches.length > 0 && (
            <section class="page-section">
              <h2 class="section-title">갈래</h2>
              <div class="branch-grid">
                {rootBranches.map((root) => (
                  <a class="branch-card" href={root.url}>
                    <span class="branch-name">
                      {root.title}
                      <span class="branch-count">{root.total}</span>
                    </span>
                    {root.description && <p class="branch-desc">{root.description}</p>}
                    {root.children.length > 0 && (
                      <p class="branch-children">
                        {root.children.map((child) => child.title).join(' · ')}
                      </p>
                    )}
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="page-section">
            <h2 class="section-title">전체 문서</h2>
            {allTags.length > 0 && (
              <div class="tag-filter" id="tag-filter">
                <button type="button" data-tag="" aria-pressed="true">전체</button>
                {allTags.map((tag) => (
                  <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>
                ))}
              </div>
            )}
            <DocList items={pages} showDescription />
            <p class="no-match" hidden>고른 태그에 해당하는 문서가 없습니다.</p>
          </section>
        </>
      )}
    </main>
    <Footer />

    <script>
      // 태그 필터. ?tag=... 로 들어와도 같은 상태가 되도록 URL 과 맞춘다.
      function setupWikiFilter() {
        const filter = document.getElementById('tag-filter')
        const list = document.querySelector<HTMLElement>('.doc-list')
        const noMatch = document.querySelector<HTMLElement>('.no-match')
        if (!list) return

        const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'))

        function apply(tag: string) {
          const shown: HTMLElement[] = []
          for (const item of items) {
            const tags = (item.dataset.tags || '').split('|').filter(Boolean)
            const show = !tag || tags.includes(tag)
            item.hidden = !show
            item.classList.remove('is-last-visible')
            if (show) shown.push(item)
          }
          // 구분선은 줄 사이에만 둔다. 뒤쪽이 숨겨지면 마지막으로 보이는 줄에서 선을 뗀다.
          shown[shown.length - 1]?.classList.add('is-last-visible')

          list.hidden = shown.length === 0
          if (noMatch) noMatch.hidden = shown.length > 0

          if (filter) {
            for (const button of Array.from(filter.querySelectorAll('button'))) {
              button.setAttribute(
                'aria-pressed',
                String((button.getAttribute('data-tag') || '') === tag),
              )
            }
          }
        }

        filter?.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest('button')
          if (!button) return
          const tag = button.getAttribute('data-tag') || ''
          const url = new URL(window.location.href)
          if (tag) url.searchParams.set('tag', tag)
          else url.searchParams.delete('tag')
          window.history.replaceState({}, '', url)
          apply(tag)
        })

        apply(new URL(window.location.href).searchParams.get('tag') || '')
      }

      document.addEventListener('astro:page-load', setupWikiFilter)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupWikiFilter)
      } else {
        setupWikiFilter()
      }
    </script>
  </body>
</html>
