---
/**
 * 갈래 페이지.
 *
 * 위에는 자기 계보를 두어 어디쯤인지 보이게 하고,
 * 본문(그 영역이 무엇인지 쓴 글) 다음에 자기 아래를 통째로 보여준다.
 *
 * 무엇이 담겼든 지도를 편다. 손자까지 몇 겹이든 한 장에 들어와야 갈래를 나눈
 * 보람이 있고, 어떤 갈래는 지도가 있고 어떤 갈래는 없으면 그게 규칙으로 읽히지 않는다.
 *
 * 다만 하위 갈래가 없는 갈래는 지도가 한 줄 부채꼴이라 문서 이름만 늘어선다.
 * 그때는 지도 아래에 설명문 달린 목록을 덧붙인다. 지도는 자리를, 목록은 내용을 말한다.
 */
import { getCollection, render } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import DocList from '../../components/DocList.astro'
import BranchMap from '../../components/BranchMap.astro'
import CodeCopyScript from '../../components/CodeCopyScript.astro'
import MermaidScript from '../../components/MermaidScript.astro'
import { getBranchIndex, ancestryOf, countDocs } from '../../lib/branches.js'

export async function getStaticPaths() {
  let entries: any[] = []
  try {
    entries = (await getCollection('branches' as any)) ?? []
  } catch {
    return []
  }

  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => {
      const id = entry.id.replace(/^\/+|\/+$/g, '').replace(/\/index$/, '')
      const slug = (entry.data.slug ?? id).replace(/^\/|\/$/g, '')
      return { params: { slug }, props: { entry, id } }
    })
}

const { entry, id } = Astro.props as any
const { Content } = await render(entry)

const index = await getBranchIndex()
const node = index.byId.get(id)!
const trail = ancestryOf(index, id)
const parents = trail.slice(0, -1)

const docItems = node.docs.map((doc) => ({
  title: doc.title,
  url: doc.url,
  description: doc.description,
  tags: doc.tags,
}))

// 갈래를 먼저 만들고 문서를 나중에 채우는 순서를 허용하기 때문에,
// 아무것도 안 담긴 갈래가 정상적으로 존재할 수 있다. 빈 채로 두지 않고 말을 건다.
const docCount = countDocs(node)
const isEmpty = docCount === 0 && node.children.length === 0
// 담긴 게 하나라도 있으면 지도를 그린다.
const hasMap = !isEmpty
// 하위 갈래가 없어 지도가 한 겹뿐일 때만 설명문 달린 목록을 덧붙인다.
// 갈래가 갈라지는 순간부터는 같은 문서를 두 번 늘어놓는 셈이 된다.
const showDocList = node.children.length === 0 && docItems.length > 0

// 0 인 항목은 세지 않는다. "문서 0개 · 하위 갈래 1개" 처럼 읽히지 않도록.
const stats = [
  docCount > 0 ? `문서 ${docCount}개` : null,
  node.children.length > 0 ? `하위 갈래 ${node.children.length}개` : null,
].filter(Boolean)
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${node.title} | 갈래 | ${config.site.title}`}
      description={node.description ?? config.site.description}
    />
    <style>
      .branch-head {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .eyebrow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 0.6rem;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
      }
      .eyebrow .kind {
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-right: 0.25rem;
      }
      .eyebrow a {
        color: var(--color-text-secondary);
        text-decoration: none;
      }
      .eyebrow a:hover {
        color: var(--color-accent);
      }
      .eyebrow .sep {
        opacity: 0.55;
      }
      .branch-head h1 {
        margin: 0 0 0.6rem 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .branch-desc {
        margin: 0;
        font-size: 1rem;
        color: var(--color-text-body);
        line-height: 1.6;
      }
      .stats {
        margin: 0.75rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
      /* 지도는 눌러 보기 전에는 그냥 그림처럼 보인다. 무엇이 되는지 한 줄로 알린다. */
      .map-hint {
        margin: -0.35rem 0 0.75rem;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
      }
      .map-hint kbd {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        padding: 0.05rem 0.3rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
      }
      .branch-body {
        color: var(--color-text-primary);
        margin-bottom: 2.5rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="page">
      <div class="branch-head">
        <div class="eyebrow">
          <span class="kind">갈래</span>
          {parents.map((parent) => (
            <>
              <a href={parent.url}>{parent.title}</a>
              <span class="sep" aria-hidden="true">›</span>
            </>
          ))}
        </div>
        <h1>{node.title}</h1>
        {node.description && <p class="branch-desc">{node.description}</p>}
        {stats.length > 0 && <p class="stats">{stats.join(' · ')}</p>}
      </div>

      <div class="branch-body prose">
        <Content />
      </div>

      {hasMap && (
        <section class="page-section">
          <h2 class="section-title">갈래 지도</h2>
          <p class="map-hint">
            숫자를 누르면 접히고, 끌면 움직입니다. <kbd>⌘</kbd>/<kbd>Ctrl</kbd> + 휠로 확대합니다.
          </p>
          <BranchMap node={node} />
        </section>
      )}

      {showDocList && (
        <section class="page-section">
          <h2 class="section-title">이 갈래의 문서</h2>
          <DocList items={docItems} showDescription />
        </section>
      )}

      {isEmpty && (
        <p class="empty-state">
          아직 이 갈래에 담긴 문서가 없습니다. 자리를 먼저 잡아 둔 갈래입니다.
        </p>
      )}
    </main>
    <Footer />
    <CodeCopyScript />
    <MermaidScript />
  </body>
</html>
