---
import { getCollection } from 'astro:content';
import config from 'virtual:blog-config';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getGitCreated } from '../../lib/git-dates.js';
import PageHeader from '../../components/PageHeader.astro';

const posts = await getCollection('posts');
const seriesPosts = posts.filter((p) => !p.data.draft && p.data.series);

// 시리즈별 그룹화
// lastUpdated 를 정한 글의 파일 경로도 같이 들고 다닌다.
// frontmatter 날짜에 시각이 없을 때 그 글의 git 최초 커밋 시각을 빌려 쓴다.
const seriesMap = new Map<
  string,
  { posts: typeof seriesPosts; lastUpdated: Date; lastUpdatedFile?: string }
>();

seriesPosts.forEach((post) => {
  const seriesName = post.data.series!;
  const current = seriesMap.get(seriesName);
  if (!current) {
    seriesMap.set(seriesName, {
      posts: [post],
      lastUpdated: post.data.date,
      lastUpdatedFile: (post as any).filePath,
    });
  } else {
    current.posts.push(post);
    if (post.data.date > current.lastUpdated) {
      current.lastUpdated = post.data.date;
      current.lastUpdatedFile = (post as any).filePath;
    }
  }
});

// 순서 정렬 및 시리즈 목록 변환
const seriesList = Array.from(seriesMap.entries()).map(([name, data]) => {
  // 포스트 내부 정렬
  data.posts.sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999));

  // 슬러그 생성 (공백 -> 하이픈, 소문자화, 특수문자 제거)
  const slug = name
    .toLowerCase()
    .replace(/[^\w\sㄱ-힣-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-');

  return {
    name,
    slug,
    postCount: data.posts.length,
    lastUpdated: data.lastUpdated,
    lastUpdatedFrom: getGitCreated(data.lastUpdatedFile),
    posts: data.posts,
  };
}).sort((a, b) => b.lastUpdated.valueOf() - a.lastUpdated.valueOf());


---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`Series | ${config.site.title}`} description="연재물 시리즈 목록" />
    <style>
      .series-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      @media (min-width: 640px) {
        .series-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
      .series-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 1.5rem;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }
      .series-card:hover {
        transform: translateY(-2px);
        border-color: var(--color-accent);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
      }
      .series-card-header {
        margin-bottom: 1rem;
      }
      .series-badge {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--color-accent);
        background: rgba(88, 166, 255, 0.1);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        display: inline-block;
        margin-bottom: 0.5rem;
      }
      .series-card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
        line-height: 1.3;
      }
      .series-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        border-top: 1px solid var(--color-border);
        padding-top: 0.75rem;
        margin-top: 1rem;
      }
      .post-count {
        font-weight: 600;
      }
      .stats {
        margin: 0.75rem 0 0;
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        font-variant-numeric: tabular-nums;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader
        title="Series"
        description="이어서 읽으면 좋은 글들을 묶었습니다."
      >
        {seriesList.length > 0 && (
          <p class="stats">시리즈 {seriesList.length}개</p>
        )}
      </PageHeader>
      {seriesList.length > 0 ? (
        <div class="series-grid">
          {seriesList.map((series) => (
            <a href={`/series/${series.slug}/`} class="series-card">
              <div class="series-card-header">
                <span class="series-badge">SERIES</span>
                <h2 class="series-card-title">{series.name}</h2>
              </div>
              <div class="series-card-footer">
                <span class="post-count">{series.postCount}개의 글</span>
                <span class="last-updated">최근 업데이트: <FormattedDate date={series.lastUpdated} timeFrom={series.lastUpdatedFrom} /></span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">아직 묶인 시리즈가 없습니다.</p>
      )}
    </main>
    <Footer />
  </body>
</html>
