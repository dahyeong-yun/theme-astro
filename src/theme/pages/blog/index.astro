---
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PageHeader from '../../components/PageHeader.astro'
import DocList from '../../components/DocList.astro'
import Pagination from '../../components/Pagination.astro'
import {
  blogPageUrl,
  getPublishedPosts,
  pageCount,
  sliceForPage,
  toDocListItem,
  rangeLabel,
} from '../../lib/posts.js'
import { pageHeading } from '../../lib/nav.js'

const posts = await getPublishedPosts()
const total = pageCount(posts.length)
const items = sliceForPage(posts, 1).map(toDocListItem)
const heading = pageHeading('/blog', { title: 'Blog' })
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${heading.title} | ${config.site.title}`}
      description={heading.description ?? config.site.description}
    />
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader title={heading.title} description={heading.description}>
        <p class="count">{rangeLabel(posts.length, 1)}</p>
      </PageHeader>

      <DocList items={items} showDescription emptyMessage="아직 쓴 글이 없습니다." />

      <Pagination current={1} total={total} hrefFor={blogPageUrl} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .count {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }
</style>
