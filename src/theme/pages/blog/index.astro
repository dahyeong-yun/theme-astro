---
import config from 'virtual:blog-config'
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PageHeader from '../../components/PageHeader.astro'
import DocList from '../../components/DocList.astro'
import Pagination from '../../components/Pagination.astro'
import {
  blogPageUrl,
  getPublishedPosts,
  pageCount,
  sliceForPage,
  toDocListItem,
} from '../../lib/posts.js'

const posts = await getPublishedPosts()
const total = pageCount(posts.length)
const items = sliceForPage(posts, 1).map(toDocListItem)
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`Blog | ${config.site.title}`} description={config.site.description} />
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader
        title="Blog"
        description="겪은 일과 그때 한 생각을 남깁니다."
      >
        <p class="count">글 {posts.length}편</p>
      </PageHeader>

      <DocList items={items} showDescription emptyMessage="아직 쓴 글이 없습니다." />

      <Pagination current={1} total={total} hrefFor={blogPageUrl} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .count {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }
</style>
