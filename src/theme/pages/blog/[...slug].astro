---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getGitCreated } from '../../lib/git-dates.js';
import { excerpt } from '../../lib/excerpt.js';
import { isVisible } from '../../lib/drafts.js';

export async function getStaticPaths() {
	// 초안은 목록에서만 빼면 주소를 아는 사람에게는 그대로 열린다. 사이트맵에도 실린다.
	// 라우트 자체를 만들지 않아야 감춘 것이 된다. wiki/[...slug] 와 같은 처리다.
	const posts = (await getCollection('posts')).filter((post) => isVisible(post.data));
	return posts.map((post) => {
		let slug = post.data.slug;
		if (slug) {
			slug = slug.replace(/^\/|\/$/g, '');
		} else {
			slug = post.id.replace(/\/index$/, '');
		}
		return {
			params: { slug },
			props: post,
		};
	});
}
type Props = CollectionEntry<'posts'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const gitCreated = getGitCreated((post as any).filePath);
// frontmatter 에 description 이 없으면 본문 앞부분을 요약문으로 쓴다.
const description = post.data.description ?? excerpt((post as any).body);
---

<BlogPost {...post.data} description={description} id={post.id} headings={headings} gitCreated={gitCreated}>
	<Content />
</BlogPost>

