---
import '../styles/global.css'
import type { ImageMetadata } from 'astro'
import config from 'virtual:blog-config'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const { title, description, image } = Astro.props
const ogImage = image ? new URL(image.src, Astro.url) : new URL('/og-default.jpg', Astro.site)

const gtmId = config.analytics?.gtm?.id
const isDev = import.meta.env.DEV
const shouldLoadGtm = gtmId && (config.analytics?.gtm?.includeInDevelopment || !isDev)
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={config.site.title}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={config.site.author} />
<html lang={config.site.language} />

<!-- Open Graph -->
{config.seo?.openGraph && (
  <>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
  </>
)}

<!-- Twitter Card -->
{config.seo?.twitterCard && (
  <>
    <meta name="twitter:card" content={config.seo.twitterCard} />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </>
)}

<!-- GTM (Partytown Web Worker로 실행) -->
{shouldLoadGtm && (
  <script type="text/partytown" define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer', gtmId);
  </script>
)}
