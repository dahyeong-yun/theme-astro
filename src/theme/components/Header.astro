---
import config from 'virtual:blog-config'
import HeaderLink from './HeaderLink.astro'
import SiteMark from './SiteMark.astro'
---

<header>
  <nav>
    <h2>
      <a href="/" aria-label={config.site.title}>
        <SiteMark size={28} />
        <span class="wordmark">{config.site.title}</span>
      </a>
    </h2>
    <div class="nav-right">
      <div class="nav-links">
        {config.navigation.map((item) => (
          <HeaderLink href={item.href}>{item.title}</HeaderLink>
        ))}
      </div>
      <button id="theme-toggle" aria-label="Toggle theme" class="theme-toggle-btn">
        <!-- Sun Icon (Light Mode -> 누르면 Dark로) -->
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="M4.93 4.93l1.41 1.41"></path>
          <path d="M17.66 17.66l1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="M6.34 17.66l-1.41 1.41"></path>
          <path d="M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (Dark Mode -> 누르면 Light로) -->
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  header {
    /* 헤더 안의 조작 요소(내비 링크, 테마 토글)는 높이와 모서리를 공유한다.
       하나만 원형이거나 하나만 각지면 그 줄이 통째로 엉성해 보인다. */
    --header-control-size: 32px;
    --header-control-radius: 8px;

    margin: 0;
    padding: 0 1.5rem;
    background: var(--color-bg-header);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    transition: background-color var(--transition-speed) var(--transition-timing),
                border-color var(--transition-speed) var(--transition-timing);
  }
  @media (max-width: 640px) {
    header {
      padding: 0 1rem;
    }
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    height: 56px;
  }
  h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  /* 마크와 글자가 한 링크다. 선이 currentColor 를 따르므로
     hover 색 전환이 마크까지 함께 간다. */
  h2 a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-header-hover);
    transition: color var(--transition-speed) var(--transition-timing);
  }
  h2 a:hover {
    color: var(--color-accent);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-links {
    display: flex;
    gap: 0.25rem;
  }
  /* 내비 링크와 같은 크기·같은 모서리 */
  .theme-toggle-btn {
    width: var(--header-control-size);
    height: var(--header-control-size);
    background: transparent;
    border: none;
    border-radius: var(--header-control-radius);
    cursor: pointer;
    color: var(--color-text-header);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-speed) var(--transition-timing),
                color var(--transition-speed) var(--transition-timing);
  }
  .theme-toggle-btn:hover {
    background: var(--color-header-hover-bg);
    color: var(--color-text-header-hover);
  }
  @media (max-width: 720px) {
    .nav-links {
      gap: 0.1rem;
    }
    .nav-right {
      gap: 0.4rem;
    }
  }
  /* 좁은 화면에서는 마크만 남긴다. 링크의 aria-label 이 이름을 대신하므로
     읽어주는 쪽에서는 그대로 "Polymorlog" 다. */
  @media (max-width: 480px) {
    .wordmark {
      display: none;
    }
  }
</style>

<script>
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    const sunIcon = toggleBtn.querySelector('.sun-icon') as HTMLElement;
    const moonIcon = toggleBtn.querySelector('.moon-icon') as HTMLElement;

    const updateIcons = (theme: string) => {
      if (theme === 'dark') {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      } else {
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      }
    };

    // 초기 아이콘 상태 맞춤
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateIcons(currentTheme);

    toggleBtn.addEventListener('click', () => {
      const theme = document.documentElement.getAttribute('data-theme');
      const nextTheme = theme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
      updateIcons(nextTheme);
    });
  }

  // Astro View Transitions 및 일반 로드 대응
  document.addEventListener('astro:page-load', setupThemeToggle);
  if (document.readyState !== 'loading') {
    setupThemeToggle();
  } else {
    document.addEventListener('DOMContentLoaded', setupThemeToggle);
  }
</script>
