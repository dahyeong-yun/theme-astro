---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		/* 테마 토글 버튼과 같은 높이·같은 모서리를 쓴다 */
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--header-control-size);
		padding: 0 0.75rem;
		border-radius: var(--header-control-radius);
		text-decoration: none;
		font-size: 0.875rem;
		/* 활성 상태에서도 굵기를 바꾸지 않는다.
		   굵어지면 칸 너비가 늘어 내비 전체가 미세하게 밀린다.
		   구분은 색과 배경만으로 충분하다. */
		font-weight: 500;
		color: var(--color-text-header);
		transition: color var(--transition-speed) var(--transition-timing),
					background-color var(--transition-speed) var(--transition-timing);
	}

	a:hover {
		color: var(--color-text-header-hover);
		background: var(--color-header-hover-bg);
	}

	a.active {
		color: var(--color-accent);
		background: var(--color-header-active-bg);
	}

	a.active:hover {
		color: var(--color-accent-hover);
	}
</style>
