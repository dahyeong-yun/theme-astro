---
/**
 * ```mermaid 코드 블록을 다이어그램으로 그리는 스크립트.
 * 본문을 렌더링하는 레이아웃에서 CodeCopyScript 와 함께 쓴다.
 *
 * markdown.syntaxHighlight.excludeLangs 에 'mermaid' 를 넣어 두었기 때문에
 * shiki 가 건드리지 않은 <pre><code class="language-mermaid"> 원본이 그대로 남는다.
 * 여기서 그 원본을 읽어 그림으로 바꾼다.
 *
 * mermaid 는 SVG 에 색을 직접 박아 넣는다. 그래서 테마가 바뀌면 CSS 로는 못 고치고
 * 원본에서 다시 그려야 한다. 원본 문자열을 계속 들고 있는 이유다.
 */
---

<script>
  const SELECTOR = 'pre > code.language-mermaid'

  type Block = {
    /** 그림이 들어갈 자리 */
    el: HTMLElement
    /** 원본. 테마가 바뀌면 이걸로 다시 그린다. */
    src: string
    /** 확대 컨트롤. 그림이 본문 폭을 넘칠 때만 보인다. */
    zoom: HTMLElement
    label: HTMLButtonElement
    /** 사용자가 정한 배율. null 이면 본문 폭에 맞춘다. */
    scale: number | null
    /** 그림의 자연폭 */
    natural: number
  }

  const blocks: Block[] = []
  let mermaid: any = null
  let seq = 0
  /** 다시 그리는 도중 테마가 또 바뀌면 앞선 배치의 결과는 버린다. */
  let token = 0

  const MIN_STEP = 1.25
  const MAX_SCALE = 2

  /** 원본 pre 를 figure 로 갈아끼우고 소스를 챙긴다. 하나라도 찾았는지 돌려준다. */
  function collect(): boolean {
    document.querySelectorAll(SELECTOR).forEach((code) => {
      const pre = code.parentElement
      if (!pre) return

      const figure = document.createElement('figure')
      figure.className = 'mermaid-diagram'
      // mermaid 는 소스에 accTitle/accDescr 이 있을 때만 title/desc 를 넣는다.
      // 그게 없어도 최소한 하나의 묶음으로는 읽히게 role 을 준다.
      figure.setAttribute('role', 'group')

      const body = document.createElement('div')
      body.className = 'mermaid-diagram__body'
      figure.appendChild(body)

      const zoom = document.createElement('div')
      zoom.className = 'mermaid-diagram__zoom'
      zoom.hidden = true
      const out = button('−', '축소')
      const label = button('100%', '본문 폭에 맞추기')
      label.classList.add('is-label')
      const into = button('＋', '확대')
      zoom.append(out, label, into)
      figure.appendChild(zoom)

      pre.replaceWith(figure)

      // 원본은 DOM 이 아니라 여기에 둔다. data 속성에 넣으면 이스케이프를 신경 써야 하고
      // 본문 검색·스크린리더에 같은 글이 두 번 잡힌다.
      const block: Block = {
        el: body,
        src: code.textContent ?? '',
        zoom,
        label,
        scale: null,
        natural: 0,
      }
      out.addEventListener('click', () => step(block, 1 / MIN_STEP))
      into.addEventListener('click', () => step(block, MIN_STEP))
      label.addEventListener('click', () => {
        block.scale = null
        applyScale(block)
      })
      blocks.push(block)
    })
    return blocks.length > 0
  }

  function button(text: string, title: string) {
    const b = document.createElement('button')
    b.type = 'button'
    b.textContent = text
    b.title = title
    b.setAttribute('aria-label', title)
    return b
  }

  /**
   * 본문 폭에 맞춘 배율. 자연폭이 본문보다 좁으면 1 이다(작은 그림을 늘리지 않는다).
   *
   * 자리 폭이 0 으로 잡히는 순간이 있다. 탭이 숨겨져 있거나 조상이 아직
   * 레이아웃을 받지 못한 때다. 그때 0 을 그대로 쓰면 그림이 폭 0 으로 굳고,
   * 폭이 돌아와도 되돌릴 근거가 사라진다. 1 로 두었다가 아래 관찰자가 고친다.
   */
  function fitScale(block: Block) {
    const width = block.el.clientWidth
    if (!block.natural || !width) return 1
    return Math.min(1, width / block.natural)
  }

  /**
   * 배율을 적용한다.
   *
   * 처음에는 언제나 본문 폭에 맞춘다. 참여자가 많은 시퀀스 다이어그램은 자연폭이
   * 2000px 을 쉽게 넘어서, 처음부터 원본 크기로 두면 가로 스크롤만 몇 화면이 된다.
   * 대신 줄여 놓으면 글자를 못 읽으므로, 넘치는 그림에는 확대 컨트롤을 붙여
   * 필요한 사람이 직접 키우게 한다.
   *
   * 확대 중에는 보고 있던 지점이 화면 밖으로 밀려나지 않도록 스크롤 중심을 맞춰 둔다.
   */
  function applyScale(block: Block) {
    const svg = block.el.querySelector('svg')
    if (!svg || !block.natural) return

    const fit = fitScale(block)
    const scale = Math.min(MAX_SCALE, Math.max(fit, block.scale ?? fit))

    // 확대 전 보고 있던 가로 위치(비율)를 기억해 두었다가 확대 후 되돌린다.
    const before = block.el.scrollWidth || 1
    const center = (block.el.scrollLeft + block.el.clientWidth / 2) / before

    svg.style.width = `${block.natural * scale}px`
    svg.style.maxWidth = 'none'

    const after = block.el.scrollWidth
    block.el.scrollLeft = center * after - block.el.clientWidth / 2

    block.label.textContent = `${Math.round(scale * 100)}%`
    // 본문 폭에 다 들어가는 그림에는 컨트롤을 띄우지 않는다.
    block.zoom.hidden = fit >= 1
    block.el.classList.toggle('is-zoomed', scale > fit + 0.001)
  }

  function step(block: Block, factor: number) {
    const fit = fitScale(block)
    const current = Math.max(fit, block.scale ?? fit)
    block.scale = Math.min(MAX_SCALE, Math.max(fit, current * factor))
    applyScale(block)
  }

  function configure() {
    const root = getComputedStyle(document.documentElement)
    const fontFamily = root.getPropertyValue('--font-sans').trim()
    const dark = document.documentElement.getAttribute('data-theme') === 'dark'

    // initialize 는 매번 기본값에서 다시 시작한다(내부적으로 setSiteConfig).
    // 그래서 바뀐 값만 넘기면 안 되고 항상 전체를 넘겨야 한다.
    mermaid.initialize({
      // mermaid 모듈은 window load 에 스스로 run() 을 건다. 우리가 직접 그리므로 끈다.
      startOnLoad: false,
      // 출력이 DOMPurify 를 지나게 둔다. 1차 콘텐츠라도 굳이 풀 이유가 없다.
      securityLevel: 'strict',
      // 기본값이면 파싱 실패 시 에러 SVG 를 담은 임시 div 가 정리되기 전에 예외가 나서
      // document.body 에 그대로 남는다. 켜 두면 양쪽 실패 경로 모두 정리하고 던진다.
      suppressErrorRendering: true,
      // 사이트 팔레트에서 색을 파생시키지 않는다. 사이트 토큰이 무채색이라
      // mermaid 의 hue 회전이 무의미해지고 순검정 배경에서 테두리가 검게 뭉갠다.
      theme: dark ? 'dark' : 'default',
      fontFamily: fontFamily || 'system-ui, sans-serif',
      themeVariables: { fontSize: '15px' },
    })
  }

  async function renderAll() {
    const mine = ++token
    configure()

    for (const block of blocks) {
      if (mine !== token) return

      // id 는 매번 새로 만든다. mermaid 는 그리기 전에 같은 id 의 기존 요소를 지우기 때문에
      // id 를 재사용하면 새 그림이 나오기 전까지 화면이 한 번 빈다.
      const id = `pm-mermaid-${++seq}`
      try {
        // 컨테이너를 넘기지 않는다. 넘기면 mermaid 가 먼저 innerHTML 을 비워서
        // 다시 그리는 동안 자리가 빈다. 안 넘기면 body 에 임시 div 를 붙여 재고 지운다.
        const { svg, bindFunctions } = await mermaid.render(id, block.src)
        if (mine !== token) return
        block.el.innerHTML = svg
        bindFunctions?.(block.el)

        // mermaid 가 useMaxWidth 기본값대로 style="max-width: {자연폭}px" 를 써 둔다.
        // 여기서 자연폭을 챙겨 두고, 그 뒤로는 우리가 폭을 정한다.
        const el = block.el.querySelector('svg')
        block.natural = Number.parseFloat(el?.style.maxWidth ?? '') || 0
        // 테마를 바꿔 다시 그려도 사용자가 정해 둔 배율은 유지된다.
        applyScale(block)

        block.el.parentElement?.classList.remove('is-error')
      } catch (err) {
        if (mine !== token) return
        // 한 다이어그램이 깨져도 페이지는 살아 있어야 한다. 원본을 그대로 돌려준다.
        console.error('[mermaid] 다이어그램을 그리지 못했다', err)
        const pre = document.createElement('pre')
        pre.textContent = block.src
        block.el.replaceChildren(pre)
        block.zoom.hidden = true
        block.el.parentElement?.classList.add('is-error')
      }
    }
  }

  async function setup() {
    // 다이어그램이 없는 페이지에서는 mermaid 를 아예 받지 않는다.
    // import 가 이 판정 뒤에 있어야 지연 로딩이 성립한다.
    if (!collect()) return

    mermaid = (await import('mermaid')).default
    await renderAll()

    // 테마 토글은 이벤트를 쏘지 않는다. html 의 data-theme 변화를 직접 본다.
    new MutationObserver(() => {
      void renderAll()
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })

    // 자리 폭이 바뀌면 '맞춤' 배율도 달라진다. 직접 키워 둔 그림은 그대로 둔다.
    const refit = () => {
      for (const block of blocks) applyScale(block)
    }

    // 자리를 직접 관찰한다. 창 크기만 보면 사이드바가 접히거나, 숨어 있던 자리가
    // 드러나며 폭이 0 에서 돌아오는 경우를 놓친다.
    // 폭이 실제로 달라졌을 때만 손댄다. 배율을 바꾸면 그림 높이가 따라 변하는데,
    // 높이에도 반응하면 관찰이 스스로를 깨워 루프 경고가 난다.
    const lastWidth = new WeakMap<Element, number>()
    const observer = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const width = entry.contentRect.width
        if (lastWidth.get(entry.target) === width) continue
        lastWidth.set(entry.target, width)
        const block = blocks.find((b) => b.el === entry.target)
        if (block) applyScale(block)
      }
    })
    for (const block of blocks) observer.observe(block.el)

    // 관찰자는 문서가 그려지지 않는 동안(숨은 탭 등) 콜백을 미룬다.
    // 창 크기 변화는 그와 별개로 오므로 같이 듣는다. applyScale 은 몇 번 더 불려도
    // 같은 결과를 내므로 겹쳐도 문제가 없다.
    window.addEventListener('resize', refit)
  }

  // 최초 로드 및 Astro 페이지 전환 대응
  document.addEventListener('astro:page-load', setup)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup)
  } else {
    setup()
  }
</script>
