---
/**
 * 목록 페이지 하단 페이지 이동.
 * 페이지가 하나뿐이면 아무것도 그리지 않는다.
 *
 * 모양은 global.css 의 .pagination 이 정한다. 위키 대문이 같은 모양을
 * 스크립트로 만들어 쓰는데, 스크립트가 만든 요소에는 scoped 해시가 붙지 않는다.
 */
interface Props {
  current: number
  total: number
  /** 페이지 번호를 URL 로 바꾸는 함수 */
  hrefFor: (page: number) => string
}

const { current, total, hrefFor } = Astro.props

/** 현재 쪽 주변만 보여주고 나머지는 줄임표로 접는다. */
function pageNumbers(current: number, total: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)

  const pages = new Set<number>([1, total, current])
  if (current - 1 > 1) pages.add(current - 1)
  if (current + 1 < total) pages.add(current + 1)

  const sorted = [...pages].sort((a, b) => a - b)
  const out: (number | '…')[] = []
  let previous = 0
  for (const page of sorted) {
    if (previous && page - previous > 1) out.push('…')
    out.push(page)
    previous = page
  }
  return out
}

const numbers = pageNumbers(current, total)
---

{total > 1 && (
  <nav class="pagination" aria-label="페이지 이동">
    {current > 1 ? (
      <a class="step" href={hrefFor(current - 1)} rel="prev">← 이전</a>
    ) : (
      <span class="step disabled" aria-hidden="true">← 이전</span>
    )}

    <ol class="pages">
      {numbers.map((page) =>
        page === '…' ? (
          <li class="gap" aria-hidden="true">…</li>
        ) : (
          <li>
            {page === current ? (
              <span class="page current" aria-current="page">{page}</span>
            ) : (
              <a class="page" href={hrefFor(page)}>{page}</a>
            )}
          </li>
        ),
      )}
    </ol>

    {current < total ? (
      <a class="step" href={hrefFor(current + 1)} rel="next">다음 →</a>
    ) : (
      <span class="step disabled" aria-hidden="true">다음 →</span>
    )}
  </nav>
)}
