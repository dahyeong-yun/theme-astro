---
/**
 * 목록 페이지 하단 페이지 이동.
 * 페이지가 하나뿐이면 아무것도 그리지 않는다.
 */
interface Props {
  current: number
  total: number
  /** 페이지 번호를 URL 로 바꾸는 함수 */
  hrefFor: (page: number) => string
}

const { current, total, hrefFor } = Astro.props

/** 현재 쪽 주변만 보여주고 나머지는 줄임표로 접는다. */
function pageNumbers(current: number, total: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)

  const pages = new Set<number>([1, total, current])
  if (current - 1 > 1) pages.add(current - 1)
  if (current + 1 < total) pages.add(current + 1)

  const sorted = [...pages].sort((a, b) => a - b)
  const out: (number | '…')[] = []
  let previous = 0
  for (const page of sorted) {
    if (previous && page - previous > 1) out.push('…')
    out.push(page)
    previous = page
  }
  return out
}

const numbers = pageNumbers(current, total)
---

{total > 1 && (
  <nav class="pagination" aria-label="페이지 이동">
    {current > 1 ? (
      <a class="step" href={hrefFor(current - 1)} rel="prev">← 이전</a>
    ) : (
      <span class="step disabled" aria-hidden="true">← 이전</span>
    )}

    <ol class="pages">
      {numbers.map((page) =>
        page === '…' ? (
          <li class="gap" aria-hidden="true">…</li>
        ) : (
          <li>
            {page === current ? (
              <span class="page current" aria-current="page">{page}</span>
            ) : (
              <a class="page" href={hrefFor(page)}>{page}</a>
            )}
          </li>
        ),
      )}
    </ol>

    {current < total ? (
      <a class="step" href={hrefFor(current + 1)} rel="next">다음 →</a>
    ) : (
      <span class="step disabled" aria-hidden="true">다음 →</span>
    )}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pages {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pages li {
    margin: 0;
    font-size: inherit;
    line-height: 1;
  }

  /* 숫자 칸과 이전/다음 칸이 같은 높이·같은 모서리를 쓴다 */
  .page,
  .step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--transition-speed) var(--transition-timing),
                background-color var(--transition-speed) var(--transition-timing);
  }

  .page {
    min-width: 32px;
    padding: 0 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  .step {
    padding: 0 0.7rem;
  }

  a.page:hover,
  a.step:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-secondary);
  }

  .page.current {
    color: var(--color-accent);
    background: var(--color-badge-bg);
    font-weight: 600;
  }

  .step.disabled {
    opacity: 0.35;
  }

  .gap {
    padding: 0 0.2rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  @media (max-width: 520px) {
    .step {
      padding: 0 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>
