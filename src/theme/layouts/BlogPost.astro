---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import SeriesBox from '../components/SeriesBox.astro'

type Props = CollectionEntry<'posts'>['data'] & {
  headings?: { depth: number; slug: string; text: string }[];
  id?: string;
  lastModified?: string;
}

const { title, description, date, banner, headings = [], series, id, lastModified } = Astro.props
---

<html lang={config.site.language}>
  <head>
    <BaseHead title={`${title} | ${config.site.title}`} description={description ?? config.site.description} />
    <style>
      .post-layout {
        display: flex;
        justify-content: center;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2em 1.5rem;
        gap: 3rem;
      }
      .post-content {
        width: 720px;
        max-width: 100%;
        flex-shrink: 0;
      }
      .post-sidebar {
        width: 240px;
        flex-shrink: 0;
        display: block;
      }
      .hero-image {
        width: 100%;
        margin-bottom: 2rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      }
      .prose {
        color: var(--color-text-primary);
      }
      .title {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .title h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .date {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
      }
      .last-modified {
        font-style: italic;
      }

      /* 모바일용 TOC 래퍼 기본 스타일 */
      .toc-mobile-wrapper {
        display: none;
      }

      /* 반응형 분기점 (1120px 이하에서 1컬럼 모드로 전환) */
      @media (max-width: 1120px) {
        .post-layout {
          flex-direction: column;
          align-items: center;
          padding: 2em 1rem;
          gap: 0;
        }
        .post-content {
          width: 100%;
          max-width: 720px;
        }
        .post-sidebar {
          display: none;
        }
        .toc-mobile-wrapper {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="post-layout">
      <article class="post-content">
        {banner && (
          <div class="hero-image">
            <Image width={1020} height={510} src={banner} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="title">
            <div class="date">
              <span>Posted on <FormattedDate date={date} /></span>
              {lastModified && new Date(lastModified).toDateString() !== date.toDateString() && (
                <span class="last-modified">
                  {" • "}Updated on <FormattedDate date={new Date(lastModified)} />
                </span>
              )}
            </div>
            <h1>{title}</h1>
          </div>
          {series && id && (
            <SeriesBox currentSeries={series} currentPostId={id} />
          )}
          {headings.length > 0 && (
            <div class="toc-mobile-wrapper">
              <TableOfContents headings={headings} isMobile={true} />
            </div>
          )}
          <slot />
        </div>
      </article>
      {headings.length > 0 && (
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </main>
    <Footer />
    <script>
      function setupCopyButtons() {
        const codeBlocks = document.querySelectorAll('pre');
        
        codeBlocks.forEach((codeBlock) => {
          // 중복 생성 방지
          if (codeBlock.querySelector('.copy-code-button')) return;
          
          const button = document.createElement('button');
          button.className = 'copy-code-button';
          button.type = 'button';
          button.setAttribute('aria-label', 'Copy code to clipboard');
          
          // SVG 아이콘 주입 (기본 복사 아이콘 및 완료 체크 아이콘)
          button.innerHTML = `
            <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
          `;
          
          codeBlock.appendChild(button);
          
          button.addEventListener('click', async () => {
            const codeElement = codeBlock.querySelector('code');
            if (!codeElement) return;
            
            // 행 번호나 다른 요소를 제외하고 순수한 텍스트 복사
            const text = codeElement.textContent || '';
            
            try {
              await navigator.clipboard.writeText(text);
              
              const copyIcon = button.querySelector('.copy-icon') as HTMLElement;
              const checkIcon = button.querySelector('.check-icon') as HTMLElement;
              
              if (copyIcon && checkIcon) {
                copyIcon.style.display = 'none';
                checkIcon.style.display = 'inline';
                button.classList.add('copied');
                
                setTimeout(() => {
                  copyIcon.style.display = 'inline';
                  checkIcon.style.display = 'none';
                  button.classList.remove('copied');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy code: ', err);
            }
          });
        });
      }

      // 최초 로드 및 Astro 페이지 전환 시 작동하도록 이벤트 리스너 등록
      document.addEventListener('astro:page-load', setupCopyButtons);
      
      // View transitions를 사용하지 않거나 초기 로딩 대응
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCopyButtons);
      } else {
        setupCopyButtons();
      }
    </script>
  </body>
</html>
