---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import SeriesBox from '../components/SeriesBox.astro'
import Backlinks from '../components/Backlinks.astro'
import CodeCopyScript from '../components/CodeCopyScript.astro'

type Props = CollectionEntry<'posts'>['data'] & {
  headings?: { depth: number; slug: string; text: string }[];
  id?: string;
  /** git 최초 커밋 시각. frontmatter 날짜에 시각이 없을 때 시·분·초를 채운다. */
  gitCreated?: Date;
}

const { title, description, date, updated, banner, headings = [], series, id, gitCreated } = Astro.props
---

<html lang={config.site.language}>
  <head>
    <BaseHead title={`${title} | ${config.site.title}`} description={description ?? config.site.description} />
    <style>
      .hero-image {
        width: 100%;
        margin-bottom: 2rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      }
      .prose {
        color: var(--color-text-primary);
      }
      .title {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .title h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .date {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
      }
      .last-modified {
        font-style: italic;
      }

    </style>
  </head>
  <body>
    <Header />
    <main class="doc-layout">
      <article class="doc-main">
        {banner && (
          <div class="hero-image">
            <Image width={1020} height={510} src={banner} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="title">
            <div class="date">
              <span>Posted on <FormattedDate date={date} timeFrom={gitCreated} /></span>
              {updated && (
                <span class="last-modified">
                  {" • "}Updated on <FormattedDate date={updated} />
                </span>
              )}
            </div>
            <h1>{title}</h1>
          </div>
          {series && id && (
            <SeriesBox currentSeries={series} currentPostId={id} />
          )}
          {headings.length > 0 && (
            <div class="toc-inline">
              <TableOfContents headings={headings} isMobile={true} />
            </div>
          )}
          <slot />
          {id && <Backlinks kind="post" id={id} />}
        </div>
      </article>
      {headings.length > 0 && (
        <aside class="doc-aside">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </main>
    <Footer />
    <CodeCopyScript />
  </body>
</html>
