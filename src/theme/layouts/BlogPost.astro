---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import SeriesBox from '../components/SeriesBox.astro'

type Props = CollectionEntry<'posts'>['data'] & {
  headings?: { depth: number; slug: string; text: string }[];
  id?: string;
  lastModified?: string;
}

const { title, description, date, banner, headings = [], series, id, lastModified } = Astro.props
---

<html lang={config.site.language}>
  <head>
    <BaseHead title={`${title} | ${config.site.title}`} description={description ?? config.site.description} />
    <style>
      .post-layout {
        display: flex;
        justify-content: center;
        max-width: 1024px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        gap: 3rem;
      }
      .post-layout.no-sidebar {
        max-width: 860px;
      }
      .post-layout.no-sidebar .post-content {
        max-width: 100%;
      }
      @media (max-width: 640px) {
        .post-layout {
          padding: 2rem 1rem;
        }
      }
      .post-content {
        width: 100%;
        max-width: 720px;
        flex-shrink: 1;
        min-width: 0;
      }
      .post-sidebar {
        width: 260px;
        flex-shrink: 0;
        display: block;
      }
      .hero-image {
        width: 100%;
        margin-bottom: 2.5rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border: 3px solid var(--color-border);
        box-shadow: 8px 8px 0px var(--color-border);
        border-radius: 4px;
      }
      .prose {
        color: var(--color-text-primary);
      }
      
      /* 거대 본문 Brutalist Card */
      .post-main-card {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        padding: 3rem;
        margin-bottom: 2rem;
        border-radius: 4px;
      }
      
      @media (max-width: 640px) {
        .post-main-card {
          padding: 1.5rem;
          margin-bottom: 1.5rem;
        }
      }

      .title-area h1 {
        margin: 0 0 1rem 0;
        font-size: 2.5rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.15;
        text-transform: uppercase;
        word-break: keep-all;
      }
      
      @media (max-width: 640px) {
        .title-area h1 {
          font-size: 1.85rem;
        }
      }

      .meta-info {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 900;
        color: var(--color-text-secondary);
        border-bottom: 2px dashed var(--color-border);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
      }

      .post-tag {
        background: var(--color-accent);
        color: var(--color-text-primary);
        padding: 0.2rem 0.5rem;
        border: 2px solid var(--color-border);
        text-transform: uppercase;
      }

      .last-modified {
        font-style: italic;
        color: var(--color-magenta);
      }

      .post-desc {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-text-secondary);
        line-height: 1.5;
      }

      .content-divider {
        border-top: 3px solid var(--color-border);
        margin: 2rem 0;
      }

      /* 모바일용 TOC 래퍼 */
      .toc-mobile-wrapper {
        display: none;
      }

      /* 반응형 분기점 */
      @media (max-width: 1120px) {
        .post-layout {
          flex-direction: column;
          align-items: center;
          padding: 2rem 1rem;
          gap: 2rem;
        }
        .post-content {
          width: 100%;
          max-width: 860px;
        }
        .post-sidebar {
          display: none;
        }
        .toc-mobile-wrapper {
          display: block;
          margin-bottom: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class={`post-layout ${headings.length === 0 ? 'no-sidebar' : ''}`}>
      <article class="post-content">
        {banner && (
          <div class="hero-image">
            <Image width={1020} height={510} src={banner} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="post-main-card">
            <div class="title-area">
              <div class="meta-info">
                {series ? (
                  <span class="post-tag">{series}</span>
                ) : (
                  <span class="post-tag">Article</span>
                )}
                <span>Posted on <FormattedDate date={date} /></span>
                {lastModified && new Date(lastModified).toDateString() !== date.toDateString() && (
                  <span class="last-modified">
                    {" • "}Updated <FormattedDate date={new Date(lastModified)} />
                  </span>
                )}
              </div>
              <h1>{title}</h1>
              {description && <p class="post-desc">{description}</p>}
            </div>
            
            <div class="content-divider"></div>
            
            {headings.length > 0 && (
              <div class="toc-mobile-wrapper">
                <TableOfContents headings={headings} isMobile={true} />
              </div>
            )}
            
            <div class="post-body-content">
              <slot />
            </div>
          </div>

          {series && id && (
            <SeriesBox currentSeries={series} currentPostId={id} />
          )}
        </div>
      </article>
      {headings.length > 0 && (
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </main>
    <Footer />
    <script>
      function setupCopyButtons() {
        const codeBlocks = document.querySelectorAll('pre');
        
        codeBlocks.forEach((codeBlock) => {
          if (codeBlock.querySelector('.copy-code-button')) return;
          
          const button = document.createElement('button');
          button.className = 'copy-code-button';
          button.type = 'button';
          button.setAttribute('aria-label', 'Copy code to clipboard');
          
          button.innerHTML = `
            <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
          `;
          
          codeBlock.appendChild(button);
          
          button.addEventListener('click', async () => {
            const codeElement = codeBlock.querySelector('code');
            if (!codeElement) return;
            
            const text = codeElement.textContent || '';
            
            try {
              await navigator.clipboard.writeText(text);
              
              const copyIcon = button.querySelector('.copy-icon') as HTMLElement;
              const checkIcon = button.querySelector('.check-icon') as HTMLElement;
              
              if (copyIcon && checkIcon) {
                copyIcon.style.display = 'none';
                checkIcon.style.display = 'inline';
                button.classList.add('copied');
                
                setTimeout(() => {
                  copyIcon.style.display = 'inline';
                  checkIcon.style.display = 'none';
                  button.classList.remove('copied');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy code: ', err);
            }
          });
        });
      }

      document.addEventListener('astro:page-load', setupCopyButtons);
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCopyButtons);
      } else {
        setupCopyButtons();
      }
    </script>
  </body>
</html>
