---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import SeriesBox from '../components/SeriesBox.astro'
import Backlinks from '../components/Backlinks.astro'
import CodeCopyScript from '../components/CodeCopyScript.astro'

type Props = CollectionEntry<'posts'>['data'] & {
  headings?: { depth: number; slug: string; text: string }[];
  id?: string;
  lastModified?: string;
  /** git 최초 커밋 시각. frontmatter 날짜에 시각이 없을 때 시·분·초를 채운다. */
  gitCreated?: Date;
}

const { title, description, date, banner, headings = [], series, id, lastModified, gitCreated } = Astro.props
---

<html lang={config.site.language}>
  <head>
    <BaseHead title={`${title} | ${config.site.title}`} description={description ?? config.site.description} />
    <style>
      .post-layout {
        display: flex;
        justify-content: center;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        gap: 3rem;
      }
      @media (max-width: 640px) {
        .post-layout {
          padding: 1.5rem 1rem;
        }
      }
      .post-content {
        width: 720px;
        max-width: 100%;
        flex-shrink: 0;
      }
      .post-sidebar {
        width: 240px;
        flex-shrink: 0;
        display: block;
      }
      .hero-image {
        width: 100%;
        margin-bottom: 2rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      }
      .prose {
        color: var(--color-text-primary);
      }
      .title {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .title h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .date {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
      }
      .last-modified {
        font-style: italic;
      }

      /* 모바일용 TOC 래퍼 기본 스타일 */
      .toc-mobile-wrapper {
        display: none;
      }

      /* 반응형 분기점 (1120px 이하에서 1컬럼 모드로 전환) */
      @media (max-width: 1120px) {
        .post-layout {
          flex-direction: column;
          align-items: center;
          padding: 2em 1rem;
          gap: 0;
        }
        .post-content {
          width: 100%;
          max-width: 720px;
        }
        .post-sidebar {
          display: none;
        }
        .toc-mobile-wrapper {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="post-layout">
      <article class="post-content">
        {banner && (
          <div class="hero-image">
            <Image width={1020} height={510} src={banner} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="title">
            <div class="date">
              <span>Posted on <FormattedDate date={date} timeFrom={gitCreated} /></span>
              {lastModified && new Date(lastModified).toDateString() !== date.toDateString() && (
                <span class="last-modified">
                  {" • "}Updated on <FormattedDate date={new Date(lastModified)} />
                </span>
              )}
            </div>
            <h1>{title}</h1>
          </div>
          {series && id && (
            <SeriesBox currentSeries={series} currentPostId={id} />
          )}
          {headings.length > 0 && (
            <div class="toc-mobile-wrapper">
              <TableOfContents headings={headings} isMobile={true} />
            </div>
          )}
          <slot />
          {id && <Backlinks kind="post" id={id} />}
        </div>
      </article>
      {headings.length > 0 && (
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </main>
    <Footer />
    <CodeCopyScript />
  </body>
</html>
