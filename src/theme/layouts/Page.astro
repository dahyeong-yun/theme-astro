---
/**
 * 날짜가 의미 없는 단독 페이지(About 등)용 레이아웃.
 *
 * 전에는 About 도 글 레이아웃을 빌려 쓰느라 발행일이 붙어 있었다.
 * 글이 아닌 페이지에 발행일이 붙으면 구조가 어긋나 보인다.
 */
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import PageHeader from '../components/PageHeader.astro'
import CodeCopyScript from '../components/CodeCopyScript.astro'

interface Props {
  title: string
  description?: string
  eyebrow?: string
}

const { title, description, eyebrow } = Astro.props
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${title} | ${config.site.title}`}
      description={description ?? config.site.description}
    />
  </head>
  <body>
    <Header />
    <main class="page">
      <PageHeader eyebrow={eyebrow} title={title} description={description} />
      <article class="prose">
        <slot />
      </article>
    </main>
    <Footer />
    <CodeCopyScript />
  </body>
</html>
