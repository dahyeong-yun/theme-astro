---
/**
 * 위키 문서 레이아웃.
 *
 * 포스트가 "쓴 날짜"를 앞세운다면 위키는 "마지막으로 손댄 날짜"를 앞세운다.
 * 배너·시리즈처럼 이야기 흐름에 붙는 장치는 두지 않고,
 * 대신 문서 사이 연결(백링크)을 본문 아래에 붙인다.
 */
import config from 'virtual:blog-config'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import Backlinks from '../components/Backlinks.astro'
import CodeCopyScript from '../components/CodeCopyScript.astro'

interface Props {
  title: string
  description?: string
  tags?: string[]
  created?: Date
  updated?: Date
  status?: 'seed' | 'growing' | 'evergreen'
  headings?: { depth: number; slug: string; text: string }[]
  id?: string
  /** git 이력에서 뽑은 최종 수정 시각. frontmatter 의 updated 가 없을 때 대신 쓴다. */
  lastModified?: string
  /** git 최초 커밋 시각. frontmatter 날짜에 시각이 없을 때 시·분·초를 채운다. */
  gitCreated?: Date
}

const {
  title,
  description,
  tags = [],
  created,
  updated,
  status,
  headings = [],
  id,
  lastModified,
  gitCreated,
} = Astro.props

const STATUS_LABEL = {
  seed: '씨앗',
  growing: '자라는 중',
  evergreen: '여물었음',
} as const

const updatedAt = updated ?? (lastModified ? new Date(lastModified) : undefined)
const wikiBase = (config.wiki?.basePath ?? '/wiki').replace(/\/+$/, '')
---

<html lang={config.site.language}>
  <head>
    <BaseHead
      title={`${title} | ${config.wiki?.title ?? 'Wiki'} | ${config.site.title}`}
      description={description ?? config.site.description}
    />
    <style>
      .wiki-layout {
        display: flex;
        justify-content: center;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        gap: 3rem;
      }
      @media (max-width: 640px) {
        .wiki-layout {
          padding: 1.5rem 1rem;
        }
      }
      .wiki-content {
        width: 720px;
        max-width: 100%;
        flex-shrink: 0;
      }
      .wiki-sidebar {
        width: 240px;
        flex-shrink: 0;
        display: block;
      }
      .prose {
        color: var(--color-text-primary);
      }
      .title {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }
      .title h1 {
        margin: 0 0 0.6rem 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .eyebrow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
      }
      .eyebrow .kind {
        color: var(--color-accent);
      }
      .status {
        padding: 0.1rem 0.42rem;
        border-radius: 4px;
        background: var(--color-badge-bg);
        color: var(--color-accent);
        letter-spacing: 0.02em;
        text-transform: none;
      }
      .wiki-desc {
        margin: 0 0 0.75rem 0;
        font-size: 1rem;
        color: var(--color-text-body);
        line-height: 1.6;
      }
      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.85rem;
        color: var(--color-text-secondary);
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
      }
      .tags a {
        font-size: 0.78rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        padding: 0.1rem 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        transition: color 0.15s, border-color 0.15s;
      }
      .tags a:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }

      .toc-mobile-wrapper {
        display: none;
      }
      @media (max-width: 1120px) {
        .wiki-layout {
          flex-direction: column;
          align-items: center;
          padding: 2rem 1rem;
          gap: 0;
        }
        .wiki-content {
          width: 100%;
          max-width: 720px;
        }
        .wiki-sidebar {
          display: none;
        }
        .toc-mobile-wrapper {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="wiki-layout">
      <article class="wiki-content">
        <div class="prose">
          <div class="title">
            <div class="eyebrow">
              <span class="kind">{config.wiki?.title ?? 'Wiki'}</span>
              {status && <span class="status">{STATUS_LABEL[status]}</span>}
            </div>
            <h1>{title}</h1>
            {description && <p class="wiki-desc">{description}</p>}
            <div class="meta">
              {updatedAt && (
                <span>마지막 갱신 <FormattedDate date={updatedAt} timeFrom={lastModified ? new Date(lastModified) : gitCreated} /></span>
              )}
              {created && (
                <span>작성 <FormattedDate date={created} timeFrom={gitCreated} /></span>
              )}
            </div>
            {tags.length > 0 && (
              <div class="tags">
                {tags.map((tag) => (
                  <a href={`${wikiBase}/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
                ))}
              </div>
            )}
          </div>
          {headings.length > 0 && (
            <div class="toc-mobile-wrapper">
              <TableOfContents headings={headings} isMobile={true} />
            </div>
          )}
          <slot />
          {id && <Backlinks kind="wiki" id={id} />}
        </div>
      </article>
      {headings.length > 0 && (
        <aside class="wiki-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </main>
    <Footer />
    <CodeCopyScript />
  </body>
</html>
