---
import { getCollection } from 'astro:content';
import config from 'virtual:blog-config';
import Header from '../../theme/components/Header.astro';
import Footer from '../../theme/components/Footer.astro';
import BaseHead from '../../theme/components/BaseHead.astro';
import FormattedDate from '../../theme/components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const seriesPosts = posts.filter((p) => !p.data.draft && p.data.series);

  // 시리즈별 그룹화
  const seriesMap = new Map<string, typeof posts>();

  seriesPosts.forEach((post) => {
    const seriesName = post.data.series!;
    const current = seriesMap.get(seriesName);
    if (!current) {
      seriesMap.set(seriesName, [post]);
    } else {
      current.push(post);
    }
  });

  return Array.from(seriesMap.entries()).map(([name, items]) => {
    // 슬러그 생성
    const slug = name
      .toLowerCase()
      .replace(/[^\w\sㄱ-힣-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');

    // 포스트 순서 정렬
    items.sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999));

    return {
      params: { slug },
      props: {
        seriesName: name,
        posts: items,
      },
    };
  });
}

const { seriesName, posts } = Astro.props;

// 포스트 링크용 슬러그 추출 함수
function getPostSlug(post: any) {
  let slug = post.data.slug;
  if (slug) {
    return slug.replace(/^\/|\/$/g, '');
  }
  return post.id.replace(/\/index$/, '').replace(/^\/|\/$/g, '');
}
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`${seriesName} | Series`} description={`${seriesName} 시리즈의 연재 포스트 목록`} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      @media (max-width: 640px) {
        main {
          padding: 2rem 1rem;
        }
      }
      
      .back-to-list {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 900;
        color: var(--color-text-primary);
        margin-bottom: 2rem;
        text-decoration: none;
        text-transform: uppercase;
        border: 2px solid var(--color-border);
        box-shadow: 2px 2px 0px var(--color-border);
        background: var(--color-surface);
        padding: 0.4rem 0.8rem;
        transition: all 0.1s ease;
      }
      .back-to-list:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0px var(--color-border);
        background: var(--color-accent);
      }
      
      .series-header-info {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        padding: 2.5rem;
        margin-bottom: 3rem;
        border-radius: 4px;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
      }
      @media (max-width: 640px) {
        .series-header-info {
          padding: 1.5rem;
          margin-bottom: 2rem;
        }
      }
      .series-badge {
        font-size: 0.75rem;
        font-weight: 900;
        color: var(--color-text-primary);
        background: var(--color-accent);
        border: 2px solid var(--color-border);
        padding: 0.2rem 0.5rem;
        border-radius: 2px;
        display: inline-block;
        margin-bottom: 1rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      h1.series-title {
        font-size: 2.2rem;
        font-weight: 900;
        margin: 0 0 1rem 0;
        color: var(--color-text-primary);
        line-height: 1.15;
        text-transform: uppercase;
      }
      .series-meta {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        font-weight: 900;
        color: var(--color-text-secondary);
      }
      
      /* 포스트 리스트 스타일 */
      .post-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
      }
      .post-item {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        border-radius: 4px;
        transition: all 0.15s ease;
      }
      .post-item:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0px var(--color-border);
        background: var(--color-accent);
      }
      .post-link {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: var(--color-text-primary);
      }
      .post-index {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--color-text-secondary);
        width: 3rem;
        text-align: center;
        flex-shrink: 0;
        border-right: 3px solid var(--color-border);
        padding-right: 0.75rem;
        white-space: nowrap;
      }
      .post-details {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        flex-grow: 1;
      }
      .post-title {
        font-size: 1.25rem;
        font-weight: 900;
        margin: 0;
        color: var(--color-text-primary);
        word-break: keep-all;
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 900;
        color: var(--color-text-secondary);
      }
      .post-desc {
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        margin: 0.25rem 0 0 0;
        word-break: keep-all;
      }

      @media (max-width: 640px) {
        .post-link {
          padding: 1rem;
          gap: 1rem;
        }
        .post-index {
          font-size: 1.25rem;
          width: 2.5rem;
          padding-right: 0.5rem;
          white-space: nowrap;
        }
        .post-title {
          font-size: 1.1rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <a href="/series" class="back-to-list">
        &larr; 전체 시리즈 목록
      </a>
      
      <div class="series-header-info">
        <span class="series-badge">SERIES</span>
        <h1 class="series-title">{seriesName}</h1>
        <div class="series-meta">
          <span>총 {posts.length}개의 포스트가 연재되었습니다.</span>
        </div>
      </div>

      <ul class="post-list">
        {posts.map((post, index) => {
          const postSlug = getPostSlug(post);
          return (
            <li class="post-item">
              <a href={`/blog/${postSlug}/`} class="post-link">
                <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="post-details">
                  <h2 class="post-title">{post.data.title}</h2>
                  {post.data.description && <p class="post-desc">{post.data.description}</p>}
                  <div class="post-meta">
                    <FormattedDate date={post.data.date} />
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </main>
    <Footer />
  </body>
</html>
