---
import { getCollection } from 'astro:content';
import config from 'virtual:blog-config';
import Header from '../../theme/components/Header.astro';
import Footer from '../../theme/components/Footer.astro';
import BaseHead from '../../theme/components/BaseHead.astro';

const posts = await getCollection('posts');
const seriesPosts = posts.filter((p) => !p.data.draft && p.data.series);

// 시리즈별 그룹화
const seriesMap = new Map<string, { posts: typeof seriesPosts; lastUpdated: Date }>();

seriesPosts.forEach((post) => {
  const seriesName = post.data.series!;
  const current = seriesMap.get(seriesName);
  if (!current) {
    seriesMap.set(seriesName, {
      posts: [post],
      lastUpdated: post.data.date,
    });
  } else {
    current.posts.push(post);
    if (post.data.date > current.lastUpdated) {
      current.lastUpdated = post.data.date;
    }
  }
});

// 순서 정렬 및 시리즈 목록 변환
const seriesList = Array.from(seriesMap.entries()).map(([name, data]) => {
  // 포스트 내부 정렬
  data.posts.sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999));

  // 슬러그 생성
  const slug = name
    .toLowerCase()
    .replace(/[^\w\sㄱ-힣-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-');

  return {
    name,
    slug,
    postCount: data.posts.length,
    lastUpdated: data.lastUpdated,
    posts: data.posts,
  };
}).sort((a, b) => b.lastUpdated.valueOf() - a.lastUpdated.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`Series | ${config.site.title}`} description="연재물 시리즈 목록" />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      @media (max-width: 640px) {
        main {
          padding: 2rem 1rem;
        }
      }
      
      .page-header {
        border-bottom: 3px solid var(--color-border);
        padding-bottom: 1.5rem;
        margin-bottom: 3rem;
      }

      .page-title {
        font-size: 2.5rem;
        font-weight: 900;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: var(--color-text-primary);
      }

      .series-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      @media (min-width: 640px) {
        .series-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
      .series-card {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        border-radius: 4px;
        padding: 1.5rem;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 200px;
        transition: all 0.15s ease;
        color: var(--color-text-primary);
      }
      .series-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0px var(--color-border);
        background: var(--color-accent);
      }
      
      .series-card-header {
        margin-bottom: 1rem;
      }
      .series-badge {
        font-size: 0.75rem;
        font-weight: 900;
        color: var(--color-text-primary);
        background: var(--color-surface-secondary);
        border: 2px solid var(--color-border);
        padding: 0.2rem 0.5rem;
        border-radius: 2px;
        display: inline-block;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
      }
      .series-card-title {
        font-size: 1.3rem;
        font-weight: 900;
        color: var(--color-text-primary);
        margin: 0;
        line-height: 1.3;
        word-break: keep-all;
      }
      .series-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        border-top: 2px solid var(--color-border);
        padding-top: 0.75rem;
        margin-top: 1rem;
        font-weight: 700;
      }
      .post-count {
        font-weight: 900;
        color: var(--color-text-primary);
      }
      .no-series {
        text-align: center;
        padding: 4rem 0;
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        border-radius: 4px;
        font-weight: 700;
        color: var(--color-text-secondary);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-header">
        <h1 class="page-title">Series</h1>
      </div>
      
      {seriesList.length > 0 ? (
        <div class="series-grid">
          {seriesList.map((series) => (
            <a href={`/series/${series.slug}/`} class="series-card">
              <div class="series-card-header">
                <span class="series-badge">SERIES</span>
                <h2 class="series-card-title">{series.name}</h2>
              </div>
              <div class="series-card-footer">
                <span class="post-count">{series.postCount} 개의 글</span>
                <span class="last-updated">최근 업데이트: {formatDate(series.lastUpdated)}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="no-series">
          <p>등록된 시리즈가 없습니다.</p>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
