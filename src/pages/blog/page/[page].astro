---
import { getCollection } from 'astro:content'
import type { Page } from 'astro'
import config from 'virtual:blog-config'
import FormattedDate from '../../../theme/components/FormattedDate.astro'
import Footer from '../../../theme/components/Footer.astro'
import Header from '../../../theme/components/Header.astro'
import BaseHead from '../../../theme/components/BaseHead.astro'

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection('posts'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 6 });
}

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={`Blog (Page ${page.currentPage}) | ${config.site.title}`} description={config.site.description} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      
      @media (max-width: 640px) {
        main {
          padding: 2rem 1rem;
        }
      }

      .page-header {
        border-bottom: 3px solid var(--color-border);
        padding-bottom: 1.5rem;
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .page-title {
        font-size: 2.5rem;
        font-weight: 900;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: var(--color-text-primary);
      }

      .page-subtitle {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-text-secondary);
        margin: 0;
      }

      .posts-grid {
        display: grid;
        grid-template-cols: 1fr;
        gap: 2rem;
      }

      @media (min-width: 640px) {
        .posts-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .post-card {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 280px;
        transition: all 0.15s ease;
        text-decoration: none;
        color: var(--color-text-primary);
      }

      .post-card:hover {
        transform: translate(-6px, -6px);
        box-shadow: 10px 10px 0px var(--color-border);
        background: var(--color-surface);
      }
      
      .post-card:hover .read-more-indicator {
        background: var(--color-accent);
      }

      .post-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
      }

      .post-badge {
        background: var(--color-surface-secondary);
        color: var(--color-text-primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 900;
        padding: 0.25rem 0.5rem;
        border: 2px solid var(--color-border);
        text-transform: uppercase;
      }

      .post-card-date {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 900;
        color: var(--color-text-secondary);
      }

      .post-card-title {
        font-size: 1.4rem;
        font-weight: 900;
        line-height: 1.2;
        margin: 0 0 1rem 0;
        word-break: keep-all;
      }

      .post-card-desc {
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
      }

      .post-card-footer {
        margin-top: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 2px solid var(--color-border);
        padding-top: 1rem;
      }

      .read-post-label {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 900;
      }

      .read-more-indicator {
        background: var(--color-surface);
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        box-shadow: 2px 2px 0px var(--color-border);
        border: 2px solid var(--color-border);
        font-weight: 900;
        transition: background-color 0.1s ease;
      }

      /* 페이징 네비게이션 스타일 */
      .pagination-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-top: 4rem;
        flex-wrap: wrap;
      }
      
      .page-numbers {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }
      
      .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        background: var(--color-surface);
        color: var(--color-text-primary);
        border: 3px solid var(--color-border);
        box-shadow: 3px 3px 0px var(--color-border);
        transition: all 0.1s ease;
      }
      
      .page-btn:hover:not(.disabled):not(.active) {
        transform: translate(-3px, -3px);
        box-shadow: 6px 6px 0px var(--color-border);
        background: var(--color-accent);
      }
      
      .page-btn.active {
        background: var(--color-surface-secondary);
        color: var(--color-text-primary);
        cursor: default;
      }
      
      .page-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
        background: var(--color-bg);
      }
      
      .prev-next {
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-header">
        <h1 class="page-title">Articles</h1>
        <p class="page-subtitle">두껍고 강렬한 네오 브루탈리즘 스타일로 전하는 개발 이야기 (Page {page.currentPage})</p>
      </div>
      
      <div class="posts-grid">
        {page.data.map((post: any) => {
          const cleanPostId = post.id.replace(/^\/|\/$/g, '').replace(/\/index$/, '');
          return (
            <a href={`/blog/${cleanPostId}/`} class="post-card">
              <div>
                <div class="post-card-header">
                  {post.data.series ? (
                    <span class="post-badge">{post.data.series}</span>
                  ) : (
                    <span class="post-badge">Post</span>
                  )}
                  <span class="post-card-date">
                    <FormattedDate date={post.data.date} />
                  </span>
                </div>
                <h2 class="post-card-title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="post-card-desc">{post.data.description}</p>
                )}
              </div>
              <div class="post-card-footer">
                <span class="read-post-label">READ ARTICLE</span>
                <div class="read-more-indicator">&rarr;</div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Pagination UI -->
      {page.lastPage > 1 && (
        <nav class="pagination-nav" aria-label="Blog pagination">
          {page.url.prev ? (
            <a href={page.currentPage === 2 ? '/blog/' : page.url.prev} class="page-btn prev-next">
              &larr; Prev
            </a>
          ) : (
            <span class="page-btn prev-next disabled">
              &larr; Prev
            </span>
          )}

          <div class="page-numbers">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
              const pageUrl = num === 1 ? '/blog/' : `/blog/page/${num}/`;
              const isCurrent = page.currentPage === num;
              return (
                <a 
                  href={pageUrl} 
                  class={`page-btn number-btn ${isCurrent ? 'active' : ''}`}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {num}
                </a>
              );
            })}
          </div>

          {page.url.next ? (
            <a href={page.url.next} class="page-btn prev-next">
              Next &rarr;
            </a>
          ) : (
            <span class="page-btn prev-next disabled">
              Next &rarr;
            </span>
          )}
        </nav>
      )}
    </main>
    <Footer />
  </body>
</html>
