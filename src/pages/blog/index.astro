---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import FormattedDate from '../../theme/components/FormattedDate.astro'
import Footer from '../../theme/components/Footer.astro'
import Header from '../../theme/components/Header.astro'
import BaseHead from '../../theme/components/BaseHead.astro'

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={config.site.title} description={config.site.description} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        font-family: var(--font-sans);
      }
      @media (max-width: 640px) {
        main {
          padding: 1.5rem 1rem;
        }
      }
      h1.page-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: var(--color-text-secondary);
        letter-spacing: -0.01em;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      ul li a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 0.15s;
        min-width: 0;
      }
      ul li a:hover {
        color: var(--color-accent);
      }
      .post-title {
        font-size: 1rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
      }
      .post-date {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">Posts</h1>
      <ul>
        {posts.map((post) => {
          const cleanPostId = post.id.replace(/^\/|\/$/g, '').replace(/\/index$/, '');
          return (
            <li>
              <a href={`/blog/${cleanPostId}/`}>
                <span class="post-title">{post.data.title}</span>
                <span class="post-date">
                  <FormattedDate date={post.data.date} />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </main>
    <Footer />
  </body>
</html>
