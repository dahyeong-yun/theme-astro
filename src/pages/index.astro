---
import config from 'virtual:blog-config'
import Footer from '../theme/components/Footer.astro'
import Header from '../theme/components/Header.astro'
import BaseHead from '../theme/components/BaseHead.astro'
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={config.site.title} description={config.site.description} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      @media (max-width: 640px) {
        main {
          padding: 1.5rem 1rem;
        }
      }
      h1 {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        font-size: 1.1rem;
        color: var(--color-text-secondary);
        margin-bottom: 3rem;
      }
      .links {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
      }
      .links a {
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.15s;
      }
      .links a.primary {
        background: var(--color-accent);
        color: #fff;
      }
      .links a.primary:hover {
        opacity: 0.85;
      }
      .links a.secondary {
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
      }
      .links a.secondary:hover {
        background: var(--color-surface);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>{config.site.title}</h1>
      <p class="subtitle">{config.site.description}</p>
      <div class="links">
        {config.navigation.map((item, i) => (
          <a href={item.href} class={i === 0 ? 'primary' : 'secondary'}>
            {item.title}
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
