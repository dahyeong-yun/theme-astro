---
import { getCollection } from 'astro:content'
import config from 'virtual:blog-config'
import Footer from '../theme/components/Footer.astro'
import Header from '../theme/components/Header.astro'
import BaseHead from '../theme/components/BaseHead.astro'
import FormattedDate from '../theme/components/FormattedDate.astro'

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)
---

<!doctype html>
<html lang={config.site.language}>
  <head>
    <BaseHead title={config.site.title} description={config.site.description} />
    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
      }
      
      @media (max-width: 640px) {
        main {
          padding: 2rem 1rem;
          gap: 2.5rem;
        }
      }

      /* Hero Banner */
      .hero-section {
        background-color: var(--color-surface-secondary);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow-hover);
        padding: 3rem;
        position: relative;
        overflow: hidden;
      }
      
      @media (max-width: 640px) {
        .hero-section {
          padding: 2rem 1.5rem;
        }
      }

      .hero-badge {
        display: inline-block;
        background: #000000;
        color: #ffffff;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 900;
        padding: 0.3rem 0.6rem;
        text-transform: uppercase;
        border: 2px solid #000000;
        margin-bottom: 1.5rem;
      }
      
      :root[data-theme="dark"] .hero-badge {
        background: #ffffff;
        color: #000000;
        border-color: #ffffff;
      }

      .hero-title {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1.1;
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.04em;
      }
      
      @media (max-width: 640px) {
        .hero-title {
          font-size: 2.2rem;
        }
      }

      .highlight-text {
        background: #ffffff;
        color: #000000;
        padding: 0.2rem 0.6rem;
        border: 3px solid var(--color-border);
        box-shadow: 4px 4px 0px var(--color-border);
        display: inline-block;
        margin-top: 0.5rem;
      }

      .hero-desc {
        font-size: 1.2rem;
        font-weight: 700;
        border-left: 5px solid var(--color-border);
        padding-left: 1rem;
        margin: 1.5rem 0 2rem 0;
        max-width: 720px;
        color: var(--color-text-primary);
      }

      /* Navigation Links Grid */
      .nav-grid-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 3px solid var(--color-border);
        padding-bottom: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .section-title {
        font-size: 1.75rem;
        font-weight: 900;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: -0.02em;
      }

      .links-grid {
        display: grid;
        grid-template-cols: 1fr;
        gap: 1.5rem;
      }

      @media (min-width: 640px) {
        .links-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .nav-card {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        padding: 2rem;
        text-decoration: none;
        color: var(--color-text-primary);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
        transition: all 0.15s ease;
      }

      .nav-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0px var(--color-border);
        background: var(--color-accent);
      }

      .nav-card-title {
        font-size: 1.5rem;
        font-weight: 900;
        margin: 0;
        text-transform: uppercase;
      }

      .nav-card-arrow {
        font-size: 1.25rem;
        font-weight: 900;
        align-self: flex-end;
      }

      /* Recent Posts Section */
      .recent-posts-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .posts-grid {
        display: grid;
        grid-template-cols: 1fr;
        gap: 1.5rem;
      }

      @media (min-width: 640px) {
        .posts-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .post-card {
        background: var(--color-surface);
        border: 3px solid var(--color-border);
        box-shadow: var(--box-shadow);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 250px;
        transition: all 0.15s ease;
        text-decoration: none;
        color: var(--color-text-primary);
      }

      .post-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0px var(--color-border);
      }

      .post-card-meta {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 900;
        color: var(--color-text-secondary);
        margin-bottom: 1rem;
      }

      .post-card-title {
        font-size: 1.25rem;
        font-weight: 900;
        line-height: 1.3;
        margin: 0 0 1rem 0;
      }

      .post-card-excerpt {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .post-card-footer {
        margin-top: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 2px solid var(--color-border);
        padding-top: 0.75rem;
      }

      .read-more-btn {
        background: var(--color-surface-secondary);
        font-size: 0.75rem;
        padding: 0.4rem 0.8rem;
        box-shadow: 2px 2px 0px var(--color-border);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Banner Section -->
      <section class="hero-section">
        <span class="hero-badge">{config.site.heroBadge || 'Welcome to the Neo-Brutal Web'}</span>
        <h1 class="hero-title">
          {config.site.title}<br />
          <span class="highlight-text">{config.site.description}</span>
        </h1>
        <p class="hero-desc">
          {config.site.heroDescription || config.site.description}
        </p>
        <a href="/blog" class="brutal-btn" style="background: var(--color-accent); font-size: 1.1rem; padding: 0.8rem 1.6rem;">
          아티클 읽어보기 &rarr;
        </a>
      </section>

      <!-- Navigation Cards Section -->
      <section class="nav-grid-section">
        <div class="section-header">
          <h2 class="section-title">Explore Sitemap</h2>
        </div>
        <div class="links-grid">
          {config.navigation.map((item) => (
            <a href={item.href} class="nav-card">
              <h3 class="nav-card-title">{item.title}</h3>
              <span class="nav-card-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Recent Posts Section -->
      {posts.length > 0 && (
        <section class="recent-posts-section">
          <div class="section-header">
            <h2 class="section-title">Recent Articles</h2>
            <a href="/blog" class="brutal-btn" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">View All</a>
          </div>
          <div class="posts-grid">
            {posts.map((post) => {
              const cleanPostId = post.id.replace(/^\/|\/$/g, '').replace(/\/index$/, '');
              return (
                <a href={`/blog/${cleanPostId}/`} class="post-card">
                  <div>
                    <div class="post-card-meta">
                      <FormattedDate date={post.data.date} />
                    </div>
                    <h3 class="post-card-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="post-card-excerpt">{post.data.description}</p>
                    )}
                  </div>
                  <div class="post-card-footer">
                    <span class="copyright" style="color: var(--color-text-primary);">READ POST</span>
                    <div class="brutal-btn read-more-btn">&rarr;</div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
